 "fps": 30,
 "duration": 51.289,
 "frames": 1539,
 "lines": [
  {
   "id": "q1",
   "card": "post-angelllanguyen",
   "kind": "read",
   "text": "Sáng nay ổng đứng ngay trước bàn, hỏi: hôm nay có nắng không?",
   "file": "prototype-08/voice/q1-c154cfb7412b-t1.1.wav",
   "start": 0.5,
   "end": 3.271
  },
  {
   "id": "intro",
   "card": "post-angelllanguyen",
   "kind": "bridge",
   "text": "Ổng ở đây là crush. Còn nắng, là mật danh cả hội dùng mỗi khi ổng đi ngang qua.",
   "file": "prototype-08/voice/intro-dde49c7ad2f2-t1.1.wav",
   "start": 4.401,
   "end": 8.555
  },
  {
   "id": "b2",
   "card": "post-angelllanguyen",
   "kind": "bridge",
   "text": "Mật mã tưởng kín như bưng, ai dè người cần biết thì biết hết. Không còn là dự báo, mà là phát sóng trực tiếp.",
   "file": "prototype-08/voice/b2-b2b53d914d4f-k1-t1.1.wav",
   "start": 8.835,
   "end": 14.581
  },
  {
   "id": "b3",
   "card": "c1-oysteroctopusococ",
   "kind": "bridge",
   "text": "Mà đặt mật danh là truyền thống của mọi hội bạn. Có hội còn đặt cho cả trường.",
   "file": "prototype-08/voice/b3-8523effc585c-t1.1.wav",
   "start": 14.861,
   "end": 19.31
  },
  {
   "id": "q2",
   "card": "c1-oysteroctopusococ",
   "kind": "read",
   "text": "Nhóm bạn cấp hai của tui đặt cho mỗi đứa trong trường một cái tên, đông quá còn phải mô tả đặc điểm mới nhớ.",
   "file": "prototype-08/voice/q2-8f50279b19ec-t1.1.wav",
   "start": 19.59,
   "end": 25.349
  },
  {
   "id": "b4",
   "card": "c1a-angelllanguyen",
   "kind": "bridge",
   "text": "Chủ bài đọc xong cũng phải gật gù: nhớ thật.",
   "file": "prototype-08/voice/b4-7f7d193e12a9-t1.1.wav",
   "start": 25.629,
   "end": 28.187
  },
  {
   "id": "q3",
   "card": "c1b-oysteroctopusococ",
   "kind": "read",
   "text": "Nhiều khi cười khùng không phải vì câu chuyện, mà vì cùng một cái nickname mà mỗi đứa nghĩ về một người khác nhau.",
   "file": "prototype-08/voice/q3-fa8d76c64e50-t1.1.wav",
   "start": 28.467,
   "end": 33.714
  },
  {
   "id": "b5",
   "card": "c1b-oysteroctopusococ",
   "kind": "bridge",
   "text": "Đỉnh cao của hội bạn thân là vậy: một mật mã, năm cách hiểu, và không ai chịu giải thích.",
   "file": "prototype-08/voice/b5-2678d443d7b5-t1.1.wav",
   "start": 34.844,
   "end": 39.723
  },
  {
   "id": "b6",
   "card": "c1b-oysteroctopusococ",
   "kind": "bridge",
   "text": "Còn crush thì sao? Chắc tới giờ vẫn tưởng hội này mê dự báo thời tiết.",
   "file": "prototype-08/voice/b6-e19dcb13b070-t1.1.wav",
   "start": 40.003,
   "end": 44.085
  },
  {
   "id": "cta",
   "card": "c1b-oysteroctopusococ",
   "kind": "bridge",
   "text": "Hội bạn của bạn đặt mật danh cho crush là gì? Kể nghe đi, câu hay nhất lên tập sau.",
   "file": "prototype-08/voice/cta-59d5fd043a73-k1-t1.1.wav",
   "start": 44.365,
   "end": 49.089
  }
 ],
