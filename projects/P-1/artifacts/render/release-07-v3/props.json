  {
   "id": "p1",
   "card": "post-m0ichanchan",
   "kind": "read",
   "text": "Lấy nhau mười chín năm, và bố tao nhắn cho mẹ tao kiểu:",
   "file": "release-07/voice/p1-fb9da62bb940-t1.1-L20.wav",
   "speaker": "m0ichanchan",
   "voice": "Trúc Ly",
   "start": 0.1,
   "end": 2.725
  },
  {
   "id": "p2",
   "card": "post-m0ichanchan",
   "kind": "read",
   "text": "Em ăn cơm chưa.",
   "file": "release-07/voice/p2-ddc260290fe9-t1.1-L20.wav",
   "speaker": "bo",
   "voice": "Thiền Tâm Đức",
   "start": 3.005,
   "end": 4.323
  },
  {
   "id": "a1",
   "card": "post-m0ichanchan",
   "kind": "bridge",
   "text": "Nhưng nhìn kỹ: mẹ tắt thông báo của bố luôn rồi.",
   "file": "release-07/voice/a1-bc27e6c94ee2-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 4.603,
   "end": 7.594
  },
  {
   "id": "c1",
   "card": "c1-dv.hqang_",
   "kind": "read",
   "text": "Sao mẹ bạn lại tắt thông báo tin nhắn của bố thế?",
   "file": "release-07/voice/c1-b87ce0b721a4-k2-t1.1-L20.wav",
   "speaker": "dv.hqang_",
   "voice": "Ngọc Huyền",
   "start": 7.874,
   "end": 10.422
  },
  {
   "id": "c1a",
   "card": "c1a-user171107374920",
   "kind": "read",
   "text": "Chắc năm phút hỏi em ăn cơm chưa một lần.",
   "file": "release-07/voice/c1a-287ecf4260b9-k1-t1.1-L20.wav",
   "speaker": "user171107374920",
   "voice": "Thiện Minh",
   "start": 10.702,
   "end": 12.962
  },
  {
   "id": "c1b",
   "card": "c1b-m0ichanchan",
   "kind": "read",
   "text": "Ê, tắt của tao nữa. Mà không hiểu sao, nhắn cái là mẹ vẫn biết mà rep luôn.",
   "file": "release-07/voice/c1b-b33daab787cb-k1-t1.1-L20.wav",
   "speaker": "m0ichanchan",
   "voice": "Trúc Ly",
   "start": 15.042,
   "end": 18.607
  },
  {
   "id": "a2",
   "card": "c1b-m0ichanchan",
   "kind": "bridge",
   "text": "Mười chín năm, vẫn rep trong một nốt nhạc.",
   "file": "release-07/voice/a2-a7691fedd94c-k1-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 18.887,
   "end": 21.296
  },
  {
   "id": "c2",
   "card": "c2-m0ichanchan",
   "kind": "read",
   "text": "Lúc sau mẹ tao rep:",
   "file": "release-07/voice/c2-b041cc7a5536-t1.1-L20.wav",
   "speaker": "m0ichanchan",
   "voice": "Trúc Ly",
   "start": 21.576,
   "end": 22.673
  },
  {
   "id": "c2m",
   "card": "c2-m0ichanchan",
   "kind": "read",
   "text": "Em ăn rồi.",
