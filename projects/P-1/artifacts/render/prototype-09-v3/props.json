 "duration": 49.665,
 "frames": 1490,
 "lines": [
  {
   "id": "cold",
   "card": "post-accclonecuaciti",
   "kind": "bridge",
   "text": "Mẹ không kén ăn, hay mẹ chưa từng được chọn?",
   "file": "prototype-09/voice/cold-02a50fe5f34a-t1.1.wav",
   "start": 0.5,
   "end": 2.835
  },
  {
   "id": "q1",
   "card": "post-accclonecuaciti",
   "kind": "read",
   "text": "Lớn rồi đi chợ, món gì tôi không ăn thì tôi sẽ không mua.",
   "file": "prototype-09/voice/q1-4e186d3c23cb-t1.1.wav",
   "start": 3.385,
   "end": 6.518
  },
  {
   "id": "intro",
   "card": "post-accclonecuaciti",
   "kind": "bridge",
   "text": "Câu này được hơn ba mươi sáu nghìn lượt thích, vì ai đọc cũng thấy mình trong đó.",
   "file": "prototype-09/voice/intro-795f8c77d75c-k2-t1.1.wav",
   "start": 7.068,
   "end": 10.794
  },
  {
   "id": "b2",
   "card": "c1-thi.enthien224",
   "kind": "bridge",
   "text": "Có người còn nhận ra, lớn lên mà chẳng biết mình thích ăn gì.",
   "file": "prototype-09/voice/b2-44dfda90d22f-t1.1.wav",
   "start": 11.344,
   "end": 14.313
  },
  {
   "id": "q2",
   "card": "c1-thi.enthien224",
   "kind": "read",
   "text": "Tôi đã không rõ lắm tôi thích ăn gì, ghét ăn gì, cho đến khi sống một mình.",
   "file": "prototype-09/voice/q2-27a36b143ad3-t1.1.wav",
   "start": 14.863,
   "end": 19.313
  },
  {
   "id": "b3",
   "card": "c1a-leminhdao158",
   "kind": "bridge",
   "text": "Rồi giật mình: lâu lắm rồi chưa ăn miếng cá nào. Hội không ăn cá kéo nhau vào điểm danh, có bạn còn tự nhận mình là trai đẹp.",
   "file": "prototype-09/voice/b3-a142953163c4-k1-t1.1.wav",
   "start": 19.863,
   "end": 26.276
  },
  {
   "id": "b4",
   "card": "c2-huyhoang21185",
   "kind": "bridge",
   "text": "Và có một bình luận nói đúng điều nhiều người nghĩ mà chưa nói ra.",
   "file": "prototype-09/voice/b4-0c7ad8fe09ef-t1.1.wav",
   "start": 26.826,
   "end": 30.036
  },
  {
   "id": "q3",
   "card": "c2-huyhoang21185",
   "kind": "read",
   "text": "Lớn rồi mới hiểu, không phải mẹ không kén ăn, mà hồi xưa mẹ có được quyền lựa đâu.",
   "file": "prototype-09/voice/q3-6f53db92297e-t1.1.wav",
   "start": 30.586,
   "end": 35.033
  },
  {
   "id": "b5",
   "card": "c2-huyhoang21185",
   "kind": "bridge",
   "text": "Ngày xưa đi chợ, mẹ chọn món cho cả nhà trước. Đến lượt mình cầm giỏ, mới hiểu quyền được kén là thứ mẹ đã nhường.",
   "file": "prototype-09/voice/b5-6fff95fb312f-t1.1.wav",
   "start": 36.433,
   "end": 42.545
  },
  {
   "id": "cta",
   "card": "c2-huyhoang21185",
   "kind": "bridge",
   "text": "Món nào bạn chỉ ăn khi về nhà với mẹ?",
   "file": "prototype-09/voice/cta-89271ca3ad2e-t1.1.wav",
   "start": 43.095,
   "end": 45.065
  }
 ],
