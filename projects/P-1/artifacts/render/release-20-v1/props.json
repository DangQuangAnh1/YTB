 "lines": [
  {
   "id": "t0",
   "card": "post-contentlonxon",
   "kind": "bridge",
   "text": "Bí mật của con trai, phần ba!",
   "file": "release-20/voice/t0-c14e828d968d-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 0.1,
   "end": 2.07
  },
  {
   "id": "p1",
   "card": "post-contentlonxon",
   "kind": "read",
   "text": "Topic: Muốn nghe sự thật về con trai, từ chính miệng của con trai ạ.",
   "file": "release-20/voice/p1-8b7361e25d73-k2-t1.1-L20.wav",
   "speaker": "contentlonxon",
   "voice": "Trúc Ly",
   "start": 2.35,
   "end": 5.486
  },
  {
   "id": "c1",
   "card": "c1-hzz_hoanganhhh",
   "kind": "read",
   "text": "Chúng tôi... không... đẻ được.",
   "file": "release-20/voice/c1-5cfb07b6fa75-t1.1-L20.wav",
   "speaker": "hzz_hoanganhhh",
   "voice": "Thái Sơn",
   "start": 5.766,
   "end": 7.29
  },
  {
   "id": "c2",
   "card": "c2-adroooo123",
   "kind": "read",
   "text": "Nếu bạn muốn làm một thằng nào đó tức điên, thì bảo: quên thở kìa. Thì nó sẽ phải thở thủ công. Ức chế vãi, tao nhắn bình luận này cũng thở thủ công, đờ cờ mờ.",
   "file": "release-20/voice/c2-804fa8aa892d-k1-t1.1-L20.wav",
   "speaker": "adroooo123",
   "voice": "Thiện Minh",
   "mutes": [
    [
     14.21,
     14.52
    ],
    [
     16.4,
     16.78
    ],
    [
     16.62,
     16.91
    ],
    [
     16.62,
     17.06
    ]
   ],
   "start": 9.37,
   "end": 17.231
  },
  {
   "id": "c4",
   "card": "c4-dvl_0312",
   "kind": "read",
   "text": "Bị từ chối tình cảm rồi, thì đéo có vụ làm bạn đâu.",
   "file": "release-20/voice/c4-6b0ae623be72-t1.1-L20.wav",
   "speaker": "dvl_0312",
   "voice": "Thiền Tâm Đức",
   "mutes": [
    [
     19.501,
     19.811
    ]
   ],
   "start": 17.811,
   "end": 21.307
  },
  {
   "id": "p2",
   "card": "post-_vuonhoaxinh_",
   "kind": "read",
   "text": "Một số bí mật của con trai mà con gái không hề biết là gì? Chúng tôi sẽ đọc và không đánh giá.",
   "file": "release-20/voice/p2-25a53c3cfdc9-t1.1-L20.wav",
   "speaker": "_vuonhoaxinh_",
   "voice": "Ngọc Huyền",
   "start": 21.587,
   "end": 26.765
  },
  {
   "id": "c5",
   "card": "c5-ldg.3011",
   "kind": "read",
   "text": "Chúng tôi mà gặp cô gái tôi thích, là sẽ bị ngu.",
   "file": "release-20/voice/c5-4333d71c6cf5-t1.1-L20.wav",
   "speaker": "ldg.3011",
   "voice": "Phạm Tuyên",
   "start": 27.045,
   "end": 29.741
  },
  {
   "id": "c5a",
   "card": "c5a-_vuonhoaxinh_",
   "kind": "read",
   "text": "Ai cũng vậy mà.",
   "file": "release-20/voice/c5a-4beeec666d7a-t1.1-L20.wav",
   "speaker": "_vuonhoaxinh_",
   "voice": "Ngọc Huyền",
   "start": 30.021,
   "end": 31.05
  },
  {
   "id": "c6",
   "card": "c6-th_hungne",
   "kind": "read",
   "text": "Buồn ngủ là đi ngủ thật. Đói là đói thật, đói sắp chết. Không có gì để mặc, tức là quần áo đéo còn gì để mặc. Gặp người mình thích, thì chỉ số thông minh được tính bằng số âm.",
   "file": "release-20/voice/c6-98a98e779311-k2-t1.1-L20.wav",
   "speaker": "th_hungne",
   "voice": "Thái Sơn",
   "mutes": [
    [
     37.14,
     37.6
    ]
   ],
   "start": 31.33,
   "end": 41.808
  },
  {
   "id": "c7",
   "card": "c7-iaoh_man",
   "kind": "read",
   "text": "Ê, tao mới quen đứa này. Ô kê, tối vô game nhá. Ê, tao chia tay nó rồi. Con gà, tối chơi game nhá.",
   "file": "release-20/voice/c7-1e155b829227-k1-t1.1-L20.wav",
   "speaker": "iaoh_man",
   "voice": "Thiện Minh",
   "start": 42.088,
   "end": 47.253
  },
  {
   "id": "c8",
   "card": "c8-little.bunny.little2",
   "kind": "read",
   "text": "Tuy tôi con gái nhưng tôi có người yêu. Người yêu tôi bảo, chị em ngồi sau xe mà áp dú dô lưng, là mấy anh ngại ngại, mà đã đã.",
   "file": "release-20/voice/c8-937dd578386c-t1.1-L20.wav",
   "speaker": "little.bunny.little2",
   "voice": "Mai Anh",
   "start": 49.333,
   "end": 56.459
  },
  {
   "id": "c9",
   "card": "c9-quanganh61",
   "kind": "read",
   "text": "Nếu trong nhà vệ sinh có năm cái bồn tiểu, lần lượt là một, hai, ba, bốn, năm. Con trai tụi tôi sẽ chọn theo thứ tự là: một, năm, ba, hai, bốn.",
   "file": "release-20/voice/c9-10cff4797991-t1.1-L20.wav",
   "speaker": "quanganh61",
   "voice": "Thiền Tâm Đức",
   "start": 57.039,
   "end": 66.863
  },
  {
   "id": "c10",
   "card": "c10-lf.bosstest",
   "kind": "read",
   "text": "Thích mặc vái, và xoay vái trước gương.",
   "file": "release-20/voice/c10-f10ca4bbc31d-t1.1-L20.wav",
   "speaker": "lf.bosstest",
   "voice": "Thiện Minh",
   "start": 67.143,
   "end": 69.04
  },
  {
   "id": "z1",
   "card": "c10-lf.bosstest",
   "kind": "bridge",
   "text": "Muốn nghe phần bốn thì bình luận nha!",
   "file": "release-20/voice/z1-00d74c5bc080-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 71.32,
   "end": 73.216
  }
 ],
