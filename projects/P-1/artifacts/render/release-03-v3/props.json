 "duration": 54.007,
 "frames": 1621,
 "lines": [
  {
   "id": "cold",
   "card": "post-x.pine",
   "kind": "bridge",
   "text": "Giữa ban ngày, một bé mèo bị bắt quả tang trên mái nhà, miệng còn ngậm nguyên tang vật.",
   "file": "release-03/voice/cold-6bf9f52a888f-t1.1.wav",
   "start": 0.5,
   "end": 4.804
  },
  {
   "id": "q1",
   "card": "post-x.pine",
   "kind": "read",
   "text": "May chụp kịp tấm hình làm bằng chứng.",
   "file": "release-03/voice/q1-7663a1fd8482-k3-t1.1.wav",
   "start": 5.084,
   "end": 6.986
  },
  {
   "id": "b1",
   "card": "post-x.pine",
   "kind": "bridge",
   "text": "Vòng cổ đỏ, ánh mắt bình thản. Nhìn là biết không phải lần đầu.",
   "file": "release-03/voice/b1-ba284a41b24d-k3-t1.1.wav",
   "start": 8.116,
   "end": 11.538
  },
  {
   "id": "b2",
   "card": "c1-thaonguyen1601x",
   "kind": "bridge",
   "text": "Cư dân mạng lập tức truy ra kẻ chủ mưu.",
   "file": "release-03/voice/b2-608fb707b7eb-t1.1.wav",
   "start": 11.818,
   "end": 14.083
  },
  {
   "id": "q2",
   "card": "c1-thaonguyen1601x",
   "kind": "read",
   "text": "Mày huấn luyện mèo trộm đồ lót phải không?",
   "file": "release-03/voice/q2-f8b5777b78f7-k1-t1.1.wav",
   "start": 14.363,
   "end": 16.408
  },
  {
   "id": "b3",
   "card": "c2-loadingbluetooth",
   "kind": "bridge",
   "text": "Rồi nạn nhân xuất hiện: sáng nay vừa phơi xong, quay đi một cái là bốc hơi.",
   "file": "release-03/voice/b3-aabdff14f99e-t1.1.wav",
   "start": 17.538,
   "end": 21.33
  },
  {
   "id": "b4",
   "card": "c3-horrorkumani",
   "kind": "bridge",
   "text": "Nhưng giả thuyết hay nhất là: mèo không trộm, mèo đang đi mai mối, kiếm người yêu cho chủ.",
   "file": "release-03/voice/b4-154cf3eea59d-k1-t1.1.wav",
   "start": 21.61,
   "end": 26.494
  },
  {
   "id": "b5",
   "card": "c3-horrorkumani",
   "kind": "bridge",
   "text": "Vì từng có bé chó trộm đồ nhà hàng xóm, anh chủ mang sang trả, thế là hai người xin số nhau luôn.",
   "file": "release-03/voice/b5-5dcad2c4145b-k1-t1.1.wav",
   "start": 26.774,
   "end": 32.016
  },
  {
   "id": "b6",
   "card": "c4-cu_2_ca",
   "kind": "bridge",
   "text": "Đúng lúc đó, chủ mưu tự thú.",
   "file": "release-03/voice/b6-80f07ba5be90-t1.1.wav",
   "start": 33.146,
   "end": 34.901
  },
  {
   "id": "q3",
   "card": "c4-cu_2_ca",
   "kind": "read",
   "text": "Mèo nhà tao đấy, sorry nha, tao bảo nó làm thế đấy thôi, xóa ảnh đi hộ tao.",
   "file": "release-03/voice/q3-08341b75ad3f-k1-t1.1.wav",
   "start": 35.181,
   "end": 40.122
  },
  {
   "id": "b7",
   "card": "c4-cu_2_ca",
   "kind": "bridge",
   "text": "Tự thú xong còn đòi xóa bằng chứng. Đúng là mèo nào chủ nấy.",
   "file": "release-03/voice/b7-9455db33dd73-t1.1.wav",
   "start": 41.252,
   "end": 44.749
  },
  {
   "id": "cta",
   "card": "c4-cu_2_ca",
   "kind": "bridge",
   "text": "Boss nhà bạn từng tha món gì về nhà chưa? Kể nghe đi, câu hay nhất lên tập sau.",
   "file": "release-03/voice/cta-90ccc8da2460-k1-t1.1.wav",
   "start": 45.029,
   "end": 49.407
  }
 ],
