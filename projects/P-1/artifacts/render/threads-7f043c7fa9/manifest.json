  "segments": [
    {
      "scene_id": "S01",
      "beat": 0,
      "text": "Một hàng cây bị bọc kín vì hoa quá nồng? Nhìn bức ảnh trong bài đăng này, rất dễ tưởng đó là chuyện thật.",
      "start_frame": 0,
      "frames": 168,
      "start_seconds": 0.0,
      "duration_seconds": 5.6
    },
    {
      "scene_id": "S01",
      "beat": 1,
      "text": "Nhưng ngay dưới bài, chính người đăng đã làm rõ: đây là ảnh meme. Câu chuyện đổi hướng từ chỗ đó.",
      "start_frame": 168,
      "frames": 154,
      "start_seconds": 5.6,
      "duration_seconds": 5.133333333333334
    },
    {
      "scene_id": "S02",
      "beat": 0,
      "text": "Bài viết trên Threads hỏi mùi hoa sữa có nồng không, kèm hình những tán cây nằm trong túi trong suốt.",
      "start_frame": 322,
      "frames": 158,
      "start_seconds": 10.733333333333333,
      "duration_seconds": 5.266666666666667
    },
    {
      "scene_id": "S02",
      "beat": 1,
      "text": "Phần hình rất dễ kéo mắt mình lại. Còn lời giải thích của tác giả thì nằm ở một câu trả lời phía dưới.",
      "start_frame": 480,
      "frames": 167,
      "start_seconds": 16.0,
      "duration_seconds": 5.566666666666666
    },
    {
      "scene_id": "S03",
      "beat": 0,
      "text": "Vì vậy, mình chỉ kể đây là một câu đùa về hoa sữa. Chưa có cơ sở lấy bức ảnh làm bằng chứng bọc cây ngoài đời.",
      "start_frame": 647,
      "frames": 187,
      "start_seconds": 21.566666666666666,
      "duration_seconds": 6.233333333333333
    },
    {
      "scene_id": "S03",
      "beat": 1,
      "text": "Một chi tiết nhỏ trong phần trả lời, nhưng thiếu nó thì câu chuyện rất dễ bị kể sai.",
      "start_frame": 834,
      "frames": 141,
      "start_seconds": 27.8,
      "duration_seconds": 4.7
    },
    {
      "scene_id": "S04",
      "beat": 0,
      "text": "Theo mình, cái duyên của câu đùa nằm ở hai trải nghiệm: có người nhớ mùa thu, có người chỉ muốn mùi hoa nhẹ đi.",
      "start_frame": 975,
      "frames": 182,
      "start_seconds": 32.5,
      "duration_seconds": 6.066666666666666
    },
    {
      "scene_id": "S04",
      "beat": 1,
      "text": "Hai cảm giác ấy có thể cùng tồn tại. Thích hay không thích một mùi hương đâu cần biến thành cuộc thi ai yêu Hà Nội hơn.",
      "start_frame": 1157,
      "frames": 180,
      "start_seconds": 38.56666666666667,
      "duration_seconds": 6.0
    },
    {
      "scene_id": "S05",
      "beat": 0,
      "text": "Mình vẫn có thể thấy ảnh buồn cười, đồng thời hỏi thêm: đây là ảnh vui, hay hình ghi lại một việc đã xảy ra?",
      "start_frame": 1337,
      "frames": 192,
      "start_seconds": 44.56666666666667,
      "duration_seconds": 6.4
    },
    {
      "scene_id": "S05",
      "beat": 1,
      "text": "Đọc thêm phản hồi của người đăng giúp tách câu đùa khỏi thông tin, trước khi mình kể lại cho người khác.",
      "start_frame": 1529,
      "frames": 156,
      "start_seconds": 50.96666666666667,
      "duration_seconds": 5.2
    },
    {
      "scene_id": "S06",
      "beat": 0,
      "text": "Nếu chỉ thấy bức ảnh lướt qua, bạn nhận ra đây là meme ngay, hay cũng phải đọc thêm mới rõ?",
      "start_frame": 1685,
      "frames": 158,
      "start_seconds": 56.166666666666664,
      "duration_seconds": 5.266666666666667
    },
    {
      "scene_id": "S06",
      "beat": 1,
      "text": "Với mình, phần đáng đọc nhất của chuyện này lại nằm ngay dưới bài đăng.",
      "start_frame": 1843,
      "frames": 114,
      "start_seconds": 61.43333333333333,
      "duration_seconds": 3.8
    }
  ],
