 "fps": 30,
 "duration": 43.745,
 "frames": 1313,
 "lines": [
  {
   "id": "intro",
   "card": "post-accclonecuaciti",
   "kind": "bridge",
   "text": "Có một câu khiến hơn ba mươi sáu nghìn người giật mình nhận ra chính mình.",
   "file": "prototype-09/voice/intro-2223336006c9-t1.1.wav",
   "start": 0.5,
   "end": 3.625
  },
  {
   "id": "q1",
   "card": "post-accclonecuaciti",
   "kind": "read",
   "text": "Tôi đã hiểu tại sao mẹ tôi không kén ăn. Lớn rồi đi chợ, món gì tôi không ăn thì tôi sẽ không mua.",
   "file": "prototype-09/voice/q1-bd324475e045-t1.1.wav",
   "start": 4.175,
   "end": 9.253
  },
  {
   "id": "b2",
   "card": "c1-thi.enthien224",
   "kind": "bridge",
   "text": "Hóa ra cả một thế hệ lớn lên mà không biết mình thích ăn gì.",
   "file": "prototype-09/voice/b2-f953eee23811-t1.1.wav",
   "start": 9.803,
   "end": 12.929
  },
  {
   "id": "q2",
   "card": "c1-thi.enthien224",
   "kind": "read",
   "text": "Tôi đã không rõ lắm tôi thích ăn gì, ghét ăn gì, cho đến khi sống một mình.",
   "file": "prototype-09/voice/q2-27a36b143ad3-t1.1.wav",
   "start": 13.479,
   "end": 17.929
  },
  {
   "id": "b3",
   "card": "c1a-leminhdao158",
   "kind": "bridge",
   "text": "Rồi một ngày giật mình: lâu lắm rồi chưa ăn miếng cá nào. Hội không ăn cá kéo nhau vào điểm danh, có bạn còn tự nhận mình là trai đẹp.",
   "file": "prototype-09/voice/b3-96a1dd38d252-t1.1.wav",
   "start": 18.479,
   "end": 25.179
  },
  {
   "id": "b4",
   "card": "c2-huyhoang21185",
   "kind": "bridge",
   "text": "Nhưng rồi có một bình luận làm cả topic chùng xuống.",
   "file": "prototype-09/voice/b4-2004f66bef1b-t1.1.wav",
   "start": 25.729,
   "end": 28.271
  },
  {
   "id": "q3",
   "card": "c2-huyhoang21185",
   "kind": "read",
   "text": "Lớn rồi mới hiểu, không phải mẹ không kén ăn, mà hồi xưa mẹ có được quyền lựa đâu.",
   "file": "prototype-09/voice/q3-6f53db92297e-t1.1.wav",
   "start": 28.821,
   "end": 33.268
  },
  {
   "id": "b5",
   "card": "c2-huyhoang21185",
   "kind": "bridge",
   "text": "Mẹ không phải không có món ghét. Mẹ chỉ quen đặt khẩu vị của cả nhà lên trước của mình.",
   "file": "prototype-09/voice/b5-4b754180cfbf-t1.1.wav",
   "start": 34.668,
   "end": 39.025
  },
  {
   "id": "cta",
   "card": "c2-huyhoang21185",
   "kind": "bridge",
   "text": "Món nào bạn chỉ ăn khi về nhà với mẹ?",
   "file": "prototype-09/voice/cta-89271ca3ad2e-t1.1.wav",
   "start": 39.575,
   "end": 41.545
  }
 ],
