 "lines": [
  {
   "id": "t0",
   "card": "post-ghannn_2805",
   "kind": "bridge",
   "text": "Bí mật của con trai, phần hai!",
   "file": "release-18/voice/t0-7e46f8e1bb18-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 0.1,
   "end": 1.851
  },
  {
   "id": "p1",
   "card": "post-ghannn_2805",
   "kind": "read",
   "text": "Topic: Muốn nghe sự thật về con trai từ chính miệng con trai ạ.",
   "file": "release-18/voice/p1-ef96b2a91f52-t1.1-L20.wav",
   "speaker": "ghannn_2805",
   "voice": "Trúc Ly",
   "start": 2.131,
   "end": 4.908
  },
  {
   "id": "c1",
   "card": "c1-dang141106",
   "kind": "read",
   "text": "Tắm nhanh nhưng ỉa lâu.",
   "file": "release-18/voice/c1-dbfeb5497f4c-k1-t1.1-L20.wav",
   "speaker": "dang141106",
   "voice": "Thiện Minh",
   "mutes": [
    [
     5.738,
     6.038
    ]
   ],
   "start": 5.188,
   "end": 6.493
  },
  {
   "id": "c1a",
   "card": "c1a-t4h1s4",
   "kind": "read",
   "text": "Mày sắp trĩ rồi đó.",
   "file": "release-18/voice/c1a-6564ee0ba9b5-k1-t1.1-L20.wav",
   "speaker": "t4h1s4",
   "voice": "Thái Sơn",
   "start": 8.573,
   "end": 9.899
  },
  {
   "id": "c1b",
   "card": "c1b-_22nd_oct_",
   "kind": "read",
   "text": "Tắm thì cầm cái điện thoại đánh điện tử, thế choá nào được mà chả lâu.",
   "file": "release-18/voice/c1b-0c06327bf4a2-k2-t1.1-L20.wav",
   "speaker": "_22nd_oct_",
   "voice": "Phạm Tuyên",
   "start": 10.179,
   "end": 13.739
  },
  {
   "id": "c2",
   "card": "c2-minhpham06123",
   "kind": "read",
   "text": "Một thằng con trai yêu bạn thật lòng, không nỡ chửi bạn đâu nhé.",
   "file": "release-18/voice/c2-3f2843263c5c-t1.1-L20.wav",
   "speaker": "minhpham06123",
   "voice": "Thiền Tâm Đức",
   "start": 14.019,
   "end": 17.957
  },
  {
   "id": "c2a",
   "card": "c2a-saptoiroinha_hehehe",
   "kind": "read",
   "text": "Này chưa đúng nè. Người yêu tao mỏ hỗn nhưng tâm lành nha. Tao bị ốm, mồm chửi tao như con, nhưng mà lấy khăn lau người cho tao, nhảy cả cái chăn điện của bố sang cho tao nằm, để cái phổi tao không bị lạnh. Chửi nhưng mà phải xem cả hành động như nào nữa nhé. Chứ mà loại chửi sướng mồm, chửi ra oai mà không làm gì, thì nó đúng là không yêu thật đâu. Mấy con vợ tỉnh táo phán đoán nha.",
   "file": "release-18/voice/c2a-00b20c704335-k2-t1.1-L20.wav",
   "speaker": "saptoiroinha_hehehe",
   "voice": "Ngọc Huyền",
   "start": 18.237,
   "end": 36.542
  },
  {
   "id": "c3",
   "card": "c3-chicovinnythoi",
   "kind": "read",
   "text": "Đi đết cầm hai trăm ca có thể không đủ, chứ đi đá bóng bao sân thì được chục đứa gọi bằng bố.",
   "file": "release-18/voice/c3-5f053968c046-t1.1-L20.wav",
   "speaker": "chicovinnythoi",
   "voice": "Thái Sơn",
   "start": 36.822,
   "end": 42.217
  },
  {
   "id": "c4",
   "card": "c4-alexander.___.ponypawpawsktt",
   "kind": "read",
   "text": "Không biết như nào, chứ nhóm bóng đá con trai thú vị hơn grúp chát chị em đấy.",
   "file": "release-18/voice/c4-6525bb1baa41-k2-t1.1-L20.wav",
   "speaker": "alexander.___.ponypawpawsktt",
   "voice": "Phạm Tuyên",
   "start": 42.797,
   "end": 47.026
  },
  {
   "id": "c4a",
   "card": "c4a-_nghkiettt_",
   "kind": "read",
   "text": "Mười nhóm chắc được ba nhóm nói về bóng đá, còn lại toàn nói về phụ nữ là nhiều.",
   "file": "release-18/voice/c4a-484b945f13f7-t1.1-L20.wav",
   "speaker": "_nghkiettt_",
   "voice": "Thiện Minh",
   "start": 47.306,
   "end": 51.231
  },
  {
   "id": "c5",
   "card": "c5-dangloc12122004",
   "kind": "read",
   "text": "Son: đỏ tươi, đỏ hồng, đỏ đất, đỏ cam. Không! Màu đỏ là màu đỏ!",
   "file": "release-18/voice/c5-0e4ff06f60dd-k1-t1.1-L20.wav",
   "speaker": "dangloc12122004",
   "voice": "Thiền Tâm Đức",
   "start": 51.511,
   "end": 56.902
  },
  {
   "id": "c6",
   "card": "c6-doranhaki",
   "kind": "read",
   "text": "Không gì gay hơn cuộc trò chuyện của hai đứa thẳng.",
   "file": "release-18/voice/c6-aaff9d4c2068-t1.1-L20.wav",
   "speaker": "doranhaki",
   "voice": "Thái Sơn",
   "start": 58.982,
   "end": 61.387
  },
  {
   "id": "c7",
   "card": "c7-gwxmg.__09",
   "kind": "read",
   "text": "Tụi nó nói trong sáng vậy thôi, chứ sự thật là đứa nào tuổi mười sáu đến hai mươi cũng từng xem sếch, và lọ hết rồi đấy.",
   "file": "release-18/voice/c7-e9863322aecc-t1.1-L20.wav",
   "speaker": "gwxmg.__09",
   "voice": "Mai Anh",
   "mutes": [
    [
     66.627,
     66.987
    ],
    [
     66.957,
     67.307
    ]
   ],
   "start": 61.667,
   "end": 67.938
  },
  {
   "id": "z1",
   "card": "c7-gwxmg.__09",
   "kind": "bridge",
   "text": "Muốn nghe phần ba thì bình luận nha!",
   "file": "release-18/voice/z1-550f8cdaed25-k1-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 70.218,
   "end": 72.044
  }
 ],
