 "lines": [
  {
   "id": "t0",
   "card": "post-phailamqualo",
   "kind": "bridge",
   "text": "Bí mật của con gái, phần một!",
   "file": "release-17/voice/t0-cb2f3a4c67da-k1-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 0.1,
   "end": 1.929
  },
  {
   "id": "p1",
   "card": "post-phailamqualo",
   "kind": "read",
   "text": "Bí mật của con gái mà con trai không biết. Chúng tôi đọc và không đánh giá.",
   "file": "release-17/voice/p1-daa7b7dcc08e-t1.1-L20.wav",
   "speaker": "phailamqualo",
   "voice": "Thiện Minh",
   "start": 2.209,
   "end": 5.853
  },
  {
   "id": "c1",
   "card": "c1-maisemayman",
   "kind": "read",
   "text": "Con gái đi chơi với con gái sẽ ăn diện và make up kì công hơn so với đi cùng người yêu.",
   "file": "release-17/voice/c1-ee43f6ec699f-t1.1-L20.wav",
   "speaker": "maisemayman",
   "voice": "Trúc Ly",
   "start": 6.133,
   "end": 9.998
  },
  {
   "id": "c2",
   "card": "c2-limzimeow",
   "kind": "read",
   "text": "Chúng toi thích ngửi đồ của mình sau khi sử dụng các ông ạ. Ngửi gối, ngửi nách, ngửi đồ lót của bản thân. Không hiểu sao mùi những chỗ này nó cuốn vãi.",
   "file": "release-17/voice/c2-1b71fc378373-t1.1-L20.wav",
   "speaker": "limzimeow",
   "voice": "Ngọc Huyền",
   "mutes": [
    [
     17.048,
     17.328
    ]
   ],
   "start": 10.278,
   "end": 17.631
  },
  {
   "id": "c3",
   "card": "c3-haiba.motkhong",
   "kind": "read",
   "text": "Gái thẳng tương tác với nhau gay hơn gái lé. Thẳng lắm mới dám gay như vậy.",
   "file": "release-17/voice/c3-89228950f262-t1.1-L20.wav",
   "speaker": "haiba.motkhong",
   "voice": "Mai Anh",
   "start": 19.711,
   "end": 23.652
  },
  {
   "id": "c4",
   "card": "c4-pomersum",
   "kind": "read",
   "text": "Chúng tôi thực sự cần một bạn trai biết chụp ảnh cho chúng tôi!",
   "file": "release-17/voice/c4-90b51fb6410d-t1.1-L20.wav",
   "speaker": "pomersum",
   "voice": "Trúc Ly",
   "start": 23.932,
   "end": 26.486
  },
  {
   "id": "p2",
   "card": "post-ryanken93",
   "kind": "read",
   "text": "Góc khuất mà con gái luôn giấu diếm.",
   "file": "release-17/voice/p2-e315aacba7cb-k1-t1.1-L20.wav",
   "speaker": "ryanken93",
   "voice": "Thiện Minh",
   "start": 27.066,
   "end": 28.747
  },
  {
   "id": "c5",
   "card": "c5-ryanken93",
   "kind": "read",
   "text": "Con gái từ chối đi chơi, có thể là do chưa gội đầu kịp.",
   "file": "release-17/voice/c5-8cc4834fad33-t1.1-L20.wav",
   "speaker": "ryanken93",
   "voice": "Thiện Minh",
   "start": 29.027,
   "end": 31.939
  },
  {
   "id": "c6",
   "card": "c6-_oaktr.7t8",
   "kind": "read",
   "text": "Chẳng có gì gọi là tán gái ở đây cả, ngay từ khi vừa gặp là mọi thứ đã được quyết định rồi. Người ta chấm ông thì rẽ đường cho ông tới tán, còn đã không ưng thì nói chuyện còn khó ấy chứ.",
   "file": "release-17/voice/c6-dd23d1d404bd-t1.1-L20.wav",
   "speaker": "_oaktr.7t8",
   "voice": "Ngọc Linh",
   "start": 34.019,
   "end": 43.554
  },
  {
   "id": "c7",
   "card": "c7-mohonthichchu",
   "kind": "read",
   "text": "Chín mươi phần trăm các anh tán đổ các chị em, là vì chị em chúng tôi cũng có thích thích, bật đèn xanh cho các anh.",
   "file": "release-17/voice/c7-dcaed130ec90-t1.1-L20.wav",
   "speaker": "mohonthichchu",
   "voice": "Ngọc Huyền",
   "start": 43.834,
   "end": 49.37
  },
  {
   "id": "c8",
   "card": "c8-hung171023",
   "kind": "read",
   "text": "Nghe qua một phen bảo. Thì các chị em đã nhắm anh dai đó sẵn rồi, xong mới ra đèn xanh cho ảnh tán. Hoặc là một chút kí hiệu mà anh em chúng tôi tự huyễn hoặc bản thân là mình đã làm cổ đổ. Chứ các chị em mà không chấm, thì mãn kiếp các anh cũng không tán được.",
   "file": "release-17/voice/c8-570051c4874e-k1-t1.1-L20.wav",
   "speaker": "hung171023",
   "voice": "Thiền Tâm Đức",
   "start": 49.65,
   "end": 66.968
  },
  {
   "id": "z1",
   "card": "c8-hung171023",
   "kind": "bridge",
   "text": "Phần hai có ngay trên kênh, nhớ theo dõi nha!",
   "file": "release-17/voice/z1-cf642c9a2f5b-k1-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 69.248,
   "end": 71.801
  }
 ],
