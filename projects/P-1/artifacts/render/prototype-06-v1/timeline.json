 "lines": [
  {
   "id": "intro",
   "card": "post-bittercake_swee",
   "kind": "bridge",
   "text": "Mẹ vừa chuyển tiền tiêu tháng này, bạn này lên Threads nhờ cả mạng nghĩ giùm một câu cảm ơn cho ngầu.",
   "file": "voice/intro-3a2c898aed61.wav",
   "start": 0.35,
   "end": 5.47
  },
  {
   "id": "b1",
   "card": "c1-benicutexiu_29",
   "kind": "bridge",
   "text": "Câu được thả tim nhiều nhất là.",
   "file": "voice/b1-655ca50b1d54.wav",
   "start": 5.75,
   "end": 7.59
  },
  {
   "id": "c1",
   "card": "c1-benicutexiu_29",
   "kind": "read",
   "text": "Nào rảnh cà phê.",
   "file": "voice/c1-9874cdfae374.wav",
   "start": 7.87,
   "end": 9.07
  },
  {
   "id": "c1r",
   "card": "c1r-tn.qang",
   "kind": "read",
   "text": "Bà cố nội này.",
   "file": "voice/c1r-37bfd21b5dbe.wav",
   "start": 9.35,
   "end": 10.31
  },
  {
   "id": "b2",
   "card": "c2-deertomars",
   "kind": "bridge",
   "text": "Có người còn sửa luôn ca dao.",
   "file": "voice/b2-a820bb85f466.wav",
   "start": 10.59,
   "end": 12.43
  },
  {
   "id": "c2a",
   "card": "c2-deertomars",
   "kind": "read",
   "text": "Công cha như núi Thái Sơn, nghĩa mẹ như nước trong nguồn chảy ra. Một lòng thờ mẹ kính cha.",
   "file": "voice/c2a-a2588da97be8.wav",
   "start": 12.71,
   "end": 17.51
  },
  {
   "id": "c2b",
   "card": "c2-deertomars",
   "kind": "read",
   "text": "Tiền con con giữ, tiền mẹ con xin.",
   "file": "voice/c2b-d6421ec3697a.wav",
   "start": 18.24,
   "end": 20.48
  },
  {
   "id": "b3",
   "card": "c3-victoryy01011",
   "kind": "bridge",
   "text": "Bản ngắn gọn có vần thì đây.",
   "file": "voice/b3-7239b32896ad.wav",
   "start": 20.76,
   "end": 22.36
  },
  {
   "id": "c3",
   "card": "c3-victoryy01011",
   "kind": "read",
   "text": "Tiền đã về ví, lòng cho về nhà, cảm ơn mẹ nha!",
   "file": "voice/c3-53cdf15d8e27.wav",
   "start": 22.64,
   "end": 25.44
  },
  {
   "id": "b4",
   "card": "c5-nhincaigi4142",
   "kind": "bridge",
   "text": "Phe cổ trang cũng không chịu thua.",
   "file": "voice/b4-608cde951e6d.wav",
   "start": 25.72,
   "end": 27.56
  },
  {
   "id": "c5",
   "card": "c5-nhincaigi4142",
   "kind": "read",
   "text": "Tạ ơn mẫu thân đã ban thưởng, hài nhi xin phép cáo lui.",
   "file": "voice/c5-d6aaab7c7555.wav",
   "start": 27.84,
   "end": 30.88
  },
  {
   "id": "b5",
   "card": "c4-myracle404",
   "kind": "bridge",
   "text": "Nhưng đỉnh nhất là người không có mẫu cảm ơn, mà có sẵn mẫu xin tiền.",
   "file": "voice/b5-04758eb8a290.wav",
   "start": 31.16,
   "end": 35.08
  },
  {
   "id": "c4",
   "card": "c4-myracle404",
   "kind": "read",
   "text": "Mẹ ơi mẹ đẹp như tiên, mẹ thêm dấu huyền mẹ gửi cho con.",
   "file": "voice/c4-079a333bdbe5.wav",
   "start": 35.36,
   "end": 38.72
  },
  {
   "id": "c6",
   "card": "c6-_ym.art_17",
   "kind": "read",
   "text": "Bác đừng xoá post nhé, để mỗi lần xin tiền tui vào lấy một câu.",
   "file": "voice/c6-5b423d8ab227.wav",
   "start": 39,
   "end": 42.52
  },
  {
   "id": "cta",
   "card": "c6-_ym.art_17",
   "kind": "bridge",
   "text": "Còn bạn, sẽ rep mẹ câu nào?",
   "file": "voice/cta-938c0e5d92b6.wav",
   "start": 42.8,
   "end": 44.4
  }
 ],
