 "fps": 30,
 "duration": 47.722,
 "frames": 1432,
 "lines": [
  {
   "id": "intro",
   "card": "post-angelllanguyen",
   "kind": "bridge",
   "text": "Hội bạn này đặt mật danh cho crush là dự báo thời tiết. Trời nắng, nghĩa là ổng đang đi ngang qua.",
   "file": "prototype-08/voice/intro-ddf4b2fb793d-t1.1.wav",
   "start": 0.5,
   "end": 5.734
  },
  {
   "id": "q1",
   "card": "post-angelllanguyen",
   "kind": "read",
   "text": "Sáng nay ổng đứng ngay trước bàn, hỏi: hôm nay có nắng không?",
   "file": "prototype-08/voice/q1-c154cfb7412b-t1.1.wav",
   "start": 6.014,
   "end": 8.785
  },
  {
   "id": "b2",
   "card": "post-angelllanguyen",
   "kind": "bridge",
   "text": "Mật mã tưởng kín như bưng, ai dè người cần biết thì biết hết. Kiểu này không còn là dự báo, mà là phát sóng trực tiếp.",
   "file": "prototype-08/voice/b2-35d1a843a7a9-t1.1.wav",
   "start": 9.915,
   "end": 16.029
  },
  {
   "id": "b3",
   "card": "c1-oysteroctopusococ",
   "kind": "bridge",
   "text": "Mà hội đặt biệt danh thì đông lắm, có bạn còn chơi lớn hơn.",
   "file": "prototype-08/voice/b3-a876b11f16bb-t1.1.wav",
   "start": 16.309,
   "end": 19.3
  },
  {
   "id": "q2",
   "card": "c1-oysteroctopusococ",
   "kind": "read",
   "text": "Nhóm bạn cấp hai của tui đặt cho mỗi đứa trong trường một cái tên, đông quá đọc nickname xong còn phải mô tả đặc điểm mới nhớ.",
   "file": "prototype-08/voice/q2-ecdfa55d7621-t1.1.wav",
   "start": 19.58,
   "end": 26.495
  },
  {
   "id": "b4",
   "card": "c1a-angelllanguyen",
   "kind": "bridge",
   "text": "Đến chủ thớt cũng phải thừa nhận là nhớ thật.",
   "file": "prototype-08/voice/b4-b96224b29520-t1.1.wav",
   "start": 26.775,
   "end": 29.256
  },
  {
   "id": "q3",
   "card": "c1b-oysteroctopusococ",
   "kind": "read",
   "text": "Nhiều khi cười khùng không phải vì câu chuyện, mà vì cùng một cái nickname mà mỗi đứa nghĩ về một người khác nhau.",
   "file": "prototype-08/voice/q3-fa8d76c64e50-t1.1.wav",
   "start": 29.536,
   "end": 34.783
  },
  {
   "id": "b5",
   "card": "c1b-oysteroctopusococ",
   "kind": "bridge",
   "text": "Đó mới là đỉnh cao của hội bạn thân: một mật mã, năm cách hiểu, và không ai chịu giải thích.",
   "file": "prototype-08/voice/b5-c1a392946c35-t1.1.wav",
   "start": 35.913,
   "end": 40.864
  },
  {
   "id": "cta",
   "card": "c1b-oysteroctopusococ",
   "kind": "bridge",
   "text": "Hội bạn bạn đặt mật danh cho crush là gì? Kể nghe đi, câu hay nhất lên tập sau.",
   "file": "prototype-08/voice/cta-341b0c9c08ce-t1.1.wav",
   "start": 41.144,
   "end": 45.522
  }
 ],
