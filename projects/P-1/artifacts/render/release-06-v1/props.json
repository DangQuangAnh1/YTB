 "lines": [
  {
   "id": "cold",
   "card": "post-ilovethreads",
   "kind": "bridge",
   "text": "Có người vừa nhận ra một sự thật: chưa từng thấy con co-gi nào ốm và sờ lim.",
   "file": "release-06/voice/cold-fbc8163ba5f6-t1.1.wav",
   "start": 0.5,
   "end": 4.355
  },
  {
   "id": "b1",
   "card": "c1-mn_sr016",
   "kind": "bridge",
   "text": "Thế là một chiếc co-gi sờ lim xuất hiện. Cạo lông xong, lộ nguyên thân hình người mẫu.",
   "file": "release-06/voice/b1-581e91d9b541-t1.1.wav",
   "start": 4.635,
   "end": 9.01
  },
  {
   "id": "q1",
   "card": "c1-mn_sr016",
   "kind": "read",
   "text": "Ganh tị với bo-đi sờ lim phít của anh chưa?",
   "file": "release-06/voice/q1-09edadc8ec44-k1-t1.1.wav",
   "start": 10.14,
   "end": 12.622
  },
  {
   "id": "b2",
   "card": "c1a-eong_eop_ha",
   "kind": "bridge",
   "text": "Nhưng mắt cư dân mạng rất tinh: sao cái mông lại mẻ mất một miếng thế kia?",
   "file": "release-06/voice/b2-7a1c0970f206-k2-t1.1.wav",
   "start": 12.902,
   "end": 16.912
  },
  {
   "id": "q2",
   "card": "c1b-mn_sr016",
   "kind": "read",
   "text": "Anh bị chó cắn, hu hu.",
   "file": "release-06/voice/q2-343b9469af67-k1-t1.1.wav",
   "start": 17.192,
   "end": 18.656
  },
  {
   "id": "b3",
   "card": "c1c-kimiuvenis",
   "kind": "bridge",
   "text": "Còn ánh mắt kia là ánh mắt uất hận, vì bị cắt khẩu phần phô mai với sữa chua ngày ba cữ.",
   "file": "release-06/voice/b3-053bac357bf9-k2-t1.1.wav",
   "start": 19.786,
   "end": 24.525
  },
  {
   "id": "b4",
   "card": "c2-thanhthuy_113",
   "kind": "bridge",
   "text": "Có người còn soi tiếp: anh có gốc hớt-ki à?",
   "file": "release-06/voice/b4-78a1fc345f0e-t1.1.wav",
   "start": 24.805,
   "end": 27.351
  },
  {
   "id": "q3",
   "card": "c2a-mn_sr016",
   "kind": "read",
   "text": "Chắc tổ tiên anh là hớt-ki, mắt con đậu con bay, hu hu.",
   "file": "release-06/voice/q3-e148fdbc879d-t1.1.wav",
   "start": 27.631,
   "end": 30.763
  },
  {
   "id": "b5",
   "card": "c2a-mn_sr016",
   "kind": "bridge",
   "text": "Một mắt xanh, một mắt nâu, đội thêm mũ đỏ. Sờ lim nhưng vẫn cực kỳ tự tin.",
   "file": "release-06/voice/b5-6ab041488295-t1.1.wav",
   "start": 31.893,
   "end": 36.114
  },
  {
   "id": "cta",
   "card": "c2a-mn_sr016",
   "kind": "bridge",
   "text": "Boss nhà bạn từng có pha biến hình nào như này chưa? Kể nghe đi, câu hay nhất lên tập sau.",
   "file": "release-06/voice/cta-4bc2a194032b-t1.1.wav",
   "start": 36.394,
   "end": 41.492
  }
 ],
