 "lines": [
  {
   "id": "p1",
   "card": "post-bikhongprv",
   "kind": "read",
   "text": "Tôi đã mất cả buổi chiều để điều tra xem người con gái nào tên là Anh Đào, mà chồng tôi lại để tên YouTube là Anh Đào.",
   "file": "release-08/voice/p1-b931ebe10ae7-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 0.1,
   "end": 5.186
  },
  {
   "id": "p2",
   "card": "post-bikhongprv",
   "kind": "read",
   "text": "Và tôi vừa hốt hoảng nhớ ra, tên chồng mình là Đào Tuấn Anh.",
   "file": "release-08/voice/p2-d9c5618936ee-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 5.466,
   "end": 8.165
  },
  {
   "id": "a1",
   "card": "post-bikhongprv",
   "kind": "bridge",
   "text": "Tên chồng đọc ngược thôi mà chị ơi.",
   "file": "release-08/voice/a1-2b82307d7ae7-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 10.345,
   "end": 12.24
  },
  {
   "id": "p3",
   "card": "post-bikhongprv",
   "kind": "read",
   "text": "Ôi, đầu óc của mẹ bỉm sữa thật là một cái gì đó khó tả. May là chưa có án mạng nào xảy ra.",
   "file": "release-08/voice/p3-f7cfdad8e1cc-k3-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 12.52,
   "end": 16.874
  },
  {
   "id": "a2",
   "card": "c1-nhatvee__",
   "kind": "bridge",
   "text": "Cư dân mạng lập tức dựng lại hiện trường:",
   "file": "release-08/voice/a2-de291806f352-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 17.154,
   "end": 19.269
  },
  {
   "id": "c1w",
   "card": "c1-nhatvee__",
   "kind": "read",
   "text": "Con nào là Anh Đào?",
   "file": "release-08/voice/c1w-34a6636bd3db-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 19.549,
   "end": 20.496
  },
  {
   "id": "c1h",
   "card": "c1-nhatvee__",
   "kind": "read",
   "text": "Con này nè! Đào Tuấn Anh nè!",
   "file": "release-08/voice/c1h-1e80be5c2143-t1.1-L20.wav",
   "speaker": "chong",
   "voice": "Thiện Minh",
   "start": 21.026,
   "end": 22.7
  },
  {
   "id": "a3",
   "card": "c1a-bikhongprv",
   "kind": "bridge",
   "text": "Chị tác giả thú nhận:",
   "file": "release-08/voice/a3-b32c14f142d3-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 24.78,
   "end": 26.083
  },
  {
   "id": "c1a",
   "card": "c1a-bikhongprv",
   "kind": "read",
   "text": "Đang soạn sẵn kịch bản: ôi trời ơi, không ai khổ được bằng mình, trong đầu, thì nhận ra tên chồng.",
   "file": "release-08/voice/c1a-cb10913b033f-k2-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 26.363,
   "end": 30.372
  },
  {
   "id": "a4",
   "card": "c2-merino0658",
   "kind": "bridge",
   "text": "Phòng điều tra kết luận:",
   "file": "release-08/voice/a4-9ff12eff0c51-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 30.652,
   "end": 31.974
  },
  {
   "id": "c2",
   "card": "c2-merino0658",
   "kind": "read",
   "text": "Khi bạn dành cả buổi chiều phá án ngoại tình, nhưng hung thủ và nạn nhân lại là một người.",
   "file": "release-08/voice/c2-ae79c1e7e469-t1.1-L20.wav",
   "speaker": "merino0658",
   "voice": "Ngọc Huyền",
   "start": 32.254,
   "end": 36.331
  },
  {
   "id": "a5",
   "card": "c3-tunhaycuoi",
   "kind": "bridge",
   "text": "Và danh hiệu dành riêng cho chị:",
   "file": "release-08/voice/a5-e1d96d3c364e-k1-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 37.211,
   "end": 38.965
  },
  {
   "id": "c3",
   "card": "c3-tunhaycuoi",
   "kind": "read",
   "text": "Sơ lốc Hôm phiên bản thiếu ngủ.",
   "file": "release-08/voice/c3-980409b5635f-t1.1-L20.wav",
   "speaker": "tunhaycuoi",
   "voice": "Mai Anh",
   "start": 39.245,
   "end": 40.925
  }
 ],
