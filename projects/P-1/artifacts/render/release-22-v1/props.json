 "frames": 2096,
 "lines": [
  {
   "id": "t0",
   "card": "post-rianggg.205",
   "kind": "bridge",
   "text": "Ngày của đàn ông là ngày nào?",
   "file": "release-22/voice/t0-a075ec4b7a3d-k2-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 0.1,
   "end": 1.709
  },
  {
   "id": "p1",
   "card": "post-rianggg.205",
   "kind": "read",
   "text": "Ngày cho phụ nữ: tám tháng ba, hai mươi tháng mười, sinh nhật. Ngày cho đàn ông: sinh nhật, sáu tháng tư, mười chín tháng mười một.",
   "file": "release-22/voice/p1-10b5fe7f45aa-t1.1-L20.wav",
   "speaker": "rianggg.205",
   "voice": "Trúc Ly",
   "start": 1.989,
   "end": 7.094
  },
  {
   "id": "c1",
   "card": "c1-minh_tiep_03",
   "kind": "read",
   "text": "Khoan khoan, ngày sáu tháng tư là cái ngày gì vậy?",
   "file": "release-22/voice/c1-3d7dee7f1a8d-t1.1-L20.wav",
   "speaker": "minh_tiep_03",
   "voice": "Thiện Minh",
   "start": 7.374,
   "end": 9.634
  },
  {
   "id": "c1a",
   "card": "c1a-cutiart_",
   "kind": "read",
   "text": "Nó là ngày do giới trẻ tự bịa ra. Sáu tư là Đồng trong bảng tuần hoàn hoá học, mà Đồng là cu. Nó chả là ngày gì cả, chủ tút chỉ đang cố gán ghép ý nghĩa cho nó thôi.",
   "file": "release-22/voice/c1a-3923cee55217-t1.1-L20.wav",
   "speaker": "cutiart_",
   "voice": "Ngọc Huyền",
   "start": 9.914,
   "end": 18.505
  },
  {
   "id": "c1b",
   "card": "c1b-minh_tiep_03",
   "kind": "read",
   "text": "Thế thì em chịu rồi.",
   "file": "release-22/voice/c1b-1dc8ac1a7659-t1.1-L20.wav",
   "speaker": "minh_tiep_03",
   "voice": "Thiện Minh",
   "start": 18.785,
   "end": 19.877
  },
  {
   "id": "c2",
   "card": "c2-gary657432",
   "kind": "read",
   "text": "Ngày cho đàn ông: sinh nhật, đám tang.",
   "file": "release-22/voice/c2-96e2d05bbcdf-k2-t1.1-L20.wav",
   "speaker": "gary657432",
   "voice": "Mai Anh",
   "start": 21.957,
   "end": 24.068
  },
  {
   "id": "c3",
   "card": "c3-cake_is.calling",
   "kind": "read",
   "text": "Còn một tháng sáu, mười bốn tháng hai cộng mười bốn tháng ba. Mười chín tháng mười một còn chung với ngày quốc tế bồn cầu.",
   "file": "release-22/voice/c3-3ca77b539a65-t1.1-L20.wav",
   "speaker": "cake_is.calling",
   "voice": "Phạm Tuyên",
   "start": 24.348,
   "end": 29.956
  },
  {
   "id": "c3a",
   "card": "c3a-rianggg.205",
   "kind": "read",
   "text": "Xét. Hép pi toa lét đây.",
   "file": "release-22/voice/c3a-cf44d55ae6a9-k2-t1.1-L20.wav",
   "speaker": "rianggg.205",
   "voice": "Trúc Ly",
   "start": 30.236,
   "end": 31.705
  },
  {
   "id": "c4",
   "card": "c4-anhtuan.imnita",
   "kind": "read",
   "text": "Thật ra đàn ông chúng tôi không để ý lắm đến những ngày dành cho mình đâu. Với đàn ông thì chúng tôi không đòi hỏi lắm sự vinh danh, âm thầm làm việc và cống hiến, miễn là mọi người đừng phủ nhận cố gắng của chúng tôi là đủ rồi.",
   "file": "release-22/voice/c4-a208ada66d48-t1.1-L20.wav",
   "speaker": "anhtuan.imnita",
   "voice": "Thiền Tâm Đức",
   "start": 32.285,
   "end": 46.984
  },
  {
   "id": "c4a",
   "card": "c4a-hotmeecutee",
   "kind": "read",
   "text": "Câm.",
   "file": "release-22/voice/c4a-908e2c33816a-k1-t1.1-L20.wav",
   "speaker": "hotmeecutee",
   "voice": "Ngọc Linh",
   "start": 47.264,
   "end": 47.783
  },
  {
   "id": "c5",
   "card": "c5-vanlamon",
   "kind": "read",
   "text": "Tiên sư bố nó, mình sinh hai mươi tháng mười, nên mất mẹ ngày sinh nhật. Còn mỗi quốc tế bồn cầu, với cái ngày tự phong đéo tính tiền.",
   "file": "release-22/voice/c5-372e3e62d361-t1.1-L20.wav",
   "speaker": "vanlamon",
   "voice": "Thái Sơn",
   "mutes": [
    [
     49.983,
     50.473
    ],
    [
     49.983,
     50.473
    ],
    [
     50.313,
     50.633
    ],
    [
     52.803,
     53.183
    ],
    [
     56.313,
     56.703
    ]
   ],
   "start": 50.063,
   "end": 57.27
  },
  {
   "id": "c6",
   "card": "c6-trieu_goi_hon_mang",
   "kind": "read",
   "text": "Mười chín tháng mười một là ngày quốc tế toa lét nhé. Mê ta ây ai, đúng không? Chỉ đúng hay không thôi, chứ không có ngoài ra.",
   "file": "release-22/voice/c6-d135e6bdc9b6-k1-t1.1-L20.wav",
   "speaker": "trieu_goi_hon_mang",
   "voice": "Ngọc Huyền",
   "start": 57.85,
   "end": 63.966
  },
  {
   "id": "c6a",
   "card": "c6a-meta.ai",
   "kind": "read",
   "text": "Đúng.",
   "file": "release-22/voice/c6a-e90b1d4ec84a-t1.1-L20.wav",
   "speaker": "meta.ai",
   "voice": "Phạm Tuyên",
   "start": 64.246,
   "end": 65.047
  },
  {
   "id": "z1",
   "card": "c6a-meta.ai",
   "kind": "bridge",
   "text": "Đàn ông muốn được tặng gì? Bình luận nha!",
   "file": "release-22/voice/z1-c8560f1edc22-k2-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 67.327,
   "end": 69.511
  }
 ],
