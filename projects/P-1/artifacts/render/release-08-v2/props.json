 "lines": [
  {
   "id": "p1",
   "card": "post-bikhongprv",
   "kind": "read",
   "text": "Tôi đã mất cả buổi chiều để điều tra xem người con gái nào tên là Minh Hà, mà chồng tôi lại để tên YouTube là Minh Hà.",
   "file": "release-08/voice/p1-f41f5621c3ff-k2-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 0.1,
   "end": 5.347
  },
  {
   "id": "p2",
   "card": "post-bikhongprv",
   "kind": "read",
   "text": "Và tôi vừa hốt hoảng nhớ ra, tên chồng mình là Hà Văn Minh.",
   "file": "release-08/voice/p2-e1fd563efda7-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 5.627,
   "end": 8.393
  },
  {
   "id": "a1",
   "card": "post-bikhongprv",
   "kind": "bridge",
   "text": "Tên chồng đọc ngược thôi mà chị ơi.",
   "file": "release-08/voice/a1-2b82307d7ae7-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 10.573,
   "end": 12.468
  },
  {
   "id": "p3",
   "card": "post-bikhongprv",
   "kind": "read",
   "text": "Ôi, đầu óc của mẹ bỉm sữa thật là một cái gì đó khó tả. May là chưa có án mạng nào xảy ra.",
   "file": "release-08/voice/p3-f7cfdad8e1cc-k3-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 12.748,
   "end": 17.102
  },
  {
   "id": "a2",
   "card": "c1-nhatvee__",
   "kind": "bridge",
   "text": "Cư dân mạng lập tức dựng lại hiện trường:",
   "file": "release-08/voice/a2-de291806f352-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 17.382,
   "end": 19.497
  },
  {
   "id": "c1w",
   "card": "c1-nhatvee__",
   "kind": "read",
   "text": "Con nào là Minh Hà?",
   "file": "release-08/voice/c1w-88ee16a30e2f-k3-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 19.777,
   "end": 20.807
  },
  {
   "id": "c1h",
   "card": "c1-nhatvee__",
   "kind": "read",
   "text": "Con này nè! Hà Văn Minh nè!",
   "file": "release-08/voice/c1h-a43180b51a9f-t1.1-L20.wav",
   "speaker": "chong",
   "voice": "Thiện Minh",
   "start": 21.337,
   "end": 23.016
  },
  {
   "id": "a3",
   "card": "c1a-bikhongprv",
   "kind": "bridge",
   "text": "Chị tác giả thú nhận:",
   "file": "release-08/voice/a3-b32c14f142d3-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 25.096,
   "end": 26.399
  },
  {
   "id": "c1a",
   "card": "c1a-bikhongprv",
   "kind": "read",
   "text": "Đang soạn sẵn kịch bản: ôi trời ơi, không ai khổ được bằng mình, trong đầu, thì nhận ra tên chồng.",
   "file": "release-08/voice/c1a-cb10913b033f-k2-t1.1-L20.wav",
   "speaker": "bikhongprv",
   "voice": "Trúc Ly",
   "start": 26.679,
   "end": 30.688
  },
  {
   "id": "a4",
   "card": "c2-merino0658",
   "kind": "bridge",
   "text": "Phòng điều tra kết luận:",
   "file": "release-08/voice/a4-9ff12eff0c51-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 30.968,
   "end": 32.29
  },
  {
   "id": "c2",
   "card": "c2-merino0658",
   "kind": "read",
   "text": "Khi bạn dành cả buổi chiều phá án ngoại tình, nhưng hung thủ và nạn nhân lại là một người.",
   "file": "release-08/voice/c2-ae79c1e7e469-t1.1-L20.wav",
   "speaker": "merino0658",
   "voice": "Ngọc Huyền",
   "start": 32.57,
   "end": 36.647
  },
  {
   "id": "a5",
   "card": "c3-tunhaycuoi",
   "kind": "bridge",
   "text": "Và danh hiệu dành riêng cho chị:",
   "file": "release-08/voice/a5-e1d96d3c364e-k1-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 37.527,
   "end": 39.281
  },
  {
   "id": "c3",
   "card": "c3-tunhaycuoi",
   "kind": "read",
   "text": "Sơ lốc Hôm phiên bản thiếu ngủ.",
   "file": "release-08/voice/c3-980409b5635f-t1.1-L20.wav",
   "speaker": "tunhaycuoi",
   "voice": "Mai Anh",
   "start": 39.561,
   "end": 41.241
  }
 ],
