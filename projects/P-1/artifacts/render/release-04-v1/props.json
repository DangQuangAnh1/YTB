 "lines": [
  {
   "id": "cold",
   "card": "post-minnwox_o9",
   "kind": "bridge",
   "text": "Mua sờ-quít-si thôi mà, shop đã bắt khách chọn… phong cách phục vụ.",
   "file": "release-04/voice/cold-079030847fa9-k1-t1.1.wav",
   "start": 0.5,
   "end": 4.51
  },
  {
   "id": "b1",
   "card": "chat1-minnwox_o9",
   "kind": "bridge",
   "text": "Năm lựa chọn: tổng tài, ca-oai, mèo, gâu, nghiêm túc. Khách hỏi lại một tiếng dạ, rồi chọn bừa số hai.",
   "file": "release-04/voice/b1-cb693d32a461-k2-t1.1.wav",
   "start": 4.79,
   "end": 10.469
  },
  {
   "id": "q1",
   "card": "chat2-minnwox_o9",
   "kind": "read",
   "text": "Ô ha dô, em chào cô chủ nhỏ ạ, hem biết, cô chủ muốn hỏi sản phẩm nào hãy nói cho em nghe nha, ừm ya, xen xây.",
   "file": "release-04/voice/q1-68bba3860588-k3-t1.1.wav",
   "start": 10.749,
   "end": 17.45
  },
  {
   "id": "b2",
   "card": "chat2-minnwox_o9",
   "kind": "bridge",
   "text": "Và khách quyết định… diễn theo luôn.",
   "file": "release-04/voice/b2-62c8ec5d38d8-t1.1.wav",
   "start": 18.58,
   "end": 20.409
  },
  {
   "id": "q2",
   "card": "chat2-minnwox_o9",
   "kind": "read",
   "text": "Cho tôi một bơ rộp và chít dẻo nhé, bé cưng ngoan. Cười khẩy.",
   "file": "release-04/voice/q2-847ededd447c-k3-t1.1.wav",
   "start": 20.689,
   "end": 23.958
  },
  {
   "id": "b3",
   "card": "chat2-minnwox_o9",
   "kind": "bridge",
   "text": "Shop đỏ mặt nhận đơn, còn thả thêm mặt cún.",
   "file": "release-04/voice/b3-caf7bbf18584-k1-t1.1.wav",
   "start": 25.088,
   "end": 27.572
  },
  {
   "id": "b4",
   "card": "chat3-minnwox_o9",
   "kind": "bridge",
   "text": "Khách chơi lớn: síp hàng, síp luôn cả người bán.",
   "file": "release-04/voice/b4-f71e6eacb633-t1.1.wav",
   "start": 27.852,
   "end": 30.628
  },
  {
   "id": "b5",
   "card": "c1-nosquishynolife._",
   "kind": "bridge",
   "text": "Chính chủ shop vào xác nhận: ai thích kiểu nào, shop chiều kiểu đó.",
   "file": "release-04/voice/b5-106a3895990a-k1-t1.1.wav",
   "start": 30.908,
   "end": 34.85
  },
  {
   "id": "q3",
   "card": "c1a-minnwox_o9",
   "kind": "read",
   "text": "Ừm, bé ngoan, chị không muốn ai phát hiện ra em đâu.",
   "file": "release-04/voice/q3-b9ffd15de0e5-t1.1.wav",
   "start": 35.13,
   "end": 38.049
  },
  {
   "id": "b6",
   "card": "c1b-pth_tp08",
   "kind": "bridge",
   "text": "Cư dân mạng kết luận: bà cũng bệnh lắm.",
   "file": "release-04/voice/b6-c20c5f33f48d-t1.1.wav",
   "start": 39.179,
   "end": 41.296
  },
  {
   "id": "b7",
   "card": "c2-nh.tragn_",
   "kind": "bridge",
   "text": "Bạn thân thì sốc toàn tập.",
   "file": "release-04/voice/b7-c75c7eec4928-t1.1.wav",
   "start": 41.576,
   "end": 43.04
  },
  {
   "id": "b8",
   "card": "c2a-minnwox_o9",
   "kind": "bridge",
   "text": "Tác giả thanh minh: shop kêu chọn thì chọn thử thôi.",
   "file": "release-04/voice/b8-feda1e09281b-k3-t1.1.wav",
   "start": 43.32,
   "end": 46.234
  },
  {
   "id": "cta",
   "card": "c2a-minnwox_o9",
   "kind": "bridge",
   "text": "Bạn sẽ chọn phong cách số mấy? Kể nghe đi, câu hay nhất lên tập sau.",
   "file": "release-04/voice/cta-0253ec96e9f5-t1.1.wav",
   "start": 46.514,
   "end": 50.23
  }
 ],
