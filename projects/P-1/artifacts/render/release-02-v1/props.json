 "frames": 1401,
 "lines": [
  {
   "id": "cold",
   "card": "post-bittercake_swee",
   "kind": "bridge",
   "text": "Mẹ vừa chuyển tiền tiêu tháng. Bạn này lên Threads hỏi: rep sao cho ngầu? Và cả mạng nhiệt tình hiến kế.",
   "file": "release-02/voice/cold-6b47629761b9-k1-t1.1.wav",
   "start": 0.5,
   "end": 5.966
  },
  {
   "id": "q1",
   "card": "c1-benicutexiu_29",
   "kind": "read",
   "text": "Nào rảnh cà phê.",
   "file": "release-02/voice/q1-26113a35f0df-t1.1.wav",
   "start": 6.246,
   "end": 7.412
  },
  {
   "id": "b1",
   "card": "c1a-tn.qang",
   "kind": "bridge",
   "text": "Rủ mẹ cà phê bằng chính tiền mẹ gửi. Người bên dưới chỉ biết thốt lên: bà cố nội này.",
   "file": "release-02/voice/b1-770192c1beee-t1.1.wav",
   "start": 8.542,
   "end": 13.282
  },
  {
   "id": "b2",
   "card": "c1a-tn.qang",
   "kind": "bridge",
   "text": "Có người còn dự đoán: chắc sổ đỏ vừa mất một trang.",
   "file": "release-02/voice/b2-77e6dc93e3b3-t1.1.wav",
   "start": 13.562,
   "end": 16.412
  },
  {
   "id": "b3",
   "card": "c2-deertomars",
   "kind": "bridge",
   "text": "Phe văn chương thì sửa luôn ca dao, mở đầu nghe rất hiếu thảo, cho tới câu cuối.",
   "file": "release-02/voice/b3-f8ed2beb7422-t1.1.wav",
   "start": 16.692,
   "end": 21.141
  },
  {
   "id": "q2",
   "card": "c2-deertomars",
   "kind": "read",
   "text": "Tiền con con giữ, tiền mẹ con xin.",
   "file": "release-02/voice/q2-1f2c5d94c799-t1.1.wav",
   "start": 21.421,
   "end": 23.61
  },
  {
   "id": "b4",
   "card": "c3-myracle404",
   "kind": "bridge",
   "text": "Nhưng đỉnh nhất là người không có mẫu cảm ơn, mà có sẵn mẫu xin thêm.",
   "file": "release-02/voice/b4-3de01d45361c-t1.1.wav",
   "start": 24.74,
   "end": 28.455
  },
  {
   "id": "q3",
   "card": "c3-myracle404",
   "kind": "read",
   "text": "Mẹ ơi mẹ đẹp như tiên, mẹ thêm dấu huyền mẹ gửi cho con.",
   "file": "release-02/voice/q3-2f44b32717d2-k1-t1.1.wav",
   "start": 28.735,
   "end": 32.23
  },
  {
   "id": "b5",
   "card": "c3-myracle404",
   "kind": "bridge",
   "text": "Tiên thêm dấu huyền thành tiền. Một dấu thôi mà đổi cả nghĩa, đúng là thiên tài ngôn ngữ.",
   "file": "release-02/voice/b5-d7671bda2128-k1-t1.1.wav",
   "start": 33.36,
   "end": 37.806
  },
  {
   "id": "cta",
   "card": "c3-myracle404",
   "kind": "bridge",
   "text": "Còn bạn, nhận tiền mẹ gửi thì sẽ rep câu nào? Câu hay nhất lên tập sau.",
   "file": "release-02/voice/cta-5ed6f10006ec-k1-t1.1.wav",
   "start": 38.086,
   "end": 42.081
  }
 ],
