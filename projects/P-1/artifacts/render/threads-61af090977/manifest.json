  "segments": [
    {
      "scene_id": "S01",
      "beat": 0,
      "text": "Một hàng cây bị bọc kín vì hoa quá nồng? Nhìn bức ảnh trong bài đăng này, rất dễ tưởng đó là chuyện thật.",
      "start_frame": 0,
      "frames": 170,
      "start_seconds": 0.0,
      "duration_seconds": 5.666666666666667
    },
    {
      "scene_id": "S01",
      "beat": 1,
      "text": "Nhưng ngay dưới bài, chính người đăng đã làm rõ: đây là ảnh đùa. Câu chuyện đổi hướng từ chỗ đó.",
      "start_frame": 170,
      "frames": 155,
      "start_seconds": 5.666666666666667,
      "duration_seconds": 5.166666666666667
    },
    {
      "scene_id": "S02",
      "beat": 0,
      "text": "Bài viết hỏi mùi hoa sữa có nồng không, kèm hình những tán cây nằm trong túi trong suốt.",
      "start_frame": 325,
      "frames": 149,
      "start_seconds": 10.833333333333334,
      "duration_seconds": 4.966666666666667
    },
    {
      "scene_id": "S02",
      "beat": 1,
      "text": "Phần hình rất dễ kéo mắt mình lại. Còn lời giải thích của tác giả thì nằm ở một câu trả lời phía dưới.",
      "start_frame": 474,
      "frames": 164,
      "start_seconds": 15.8,
      "duration_seconds": 5.466666666666667
    },
    {
      "scene_id": "S03",
      "beat": 0,
      "text": "Vì vậy, mình chỉ kể đây là một câu đùa về hoa sữa. Chưa có cơ sở lấy bức ảnh làm bằng chứng bọc cây ngoài đời.",
      "start_frame": 638,
      "frames": 186,
      "start_seconds": 21.266666666666666,
      "duration_seconds": 6.2
    },
    {
      "scene_id": "S03",
      "beat": 1,
      "text": "Một chi tiết nhỏ trong phần trả lời, nhưng thiếu nó thì câu chuyện rất dễ bị kể sai.",
      "start_frame": 824,
      "frames": 146,
      "start_seconds": 27.466666666666665,
      "duration_seconds": 4.866666666666666
    },
    {
      "scene_id": "S04",
      "beat": 0,
      "text": "Theo mình, điểm thú vị của câu đùa nằm ở hai trải nghiệm: có người nhớ mùa thu, có người chỉ muốn mùi hoa nhẹ đi.",
      "start_frame": 970,
      "frames": 199,
      "start_seconds": 32.333333333333336,
      "duration_seconds": 6.633333333333334
    },
    {
      "scene_id": "S04",
      "beat": 1,
      "text": "Hai cảm giác ấy có thể cùng tồn tại. Thích hay không thích một mùi hương đâu cần biến thành cuộc thi ai yêu Hà Nội hơn.",
      "start_frame": 1169,
      "frames": 180,
      "start_seconds": 38.96666666666667,
      "duration_seconds": 6.0
    },
    {
      "scene_id": "S05",
      "beat": 0,
      "text": "Mình vẫn có thể thấy ảnh buồn cười, đồng thời hỏi thêm: đây là ảnh vui, hay hình ghi lại một việc đã xảy ra?",
      "start_frame": 1349,
      "frames": 193,
      "start_seconds": 44.96666666666667,
      "duration_seconds": 6.433333333333334
    },
    {
      "scene_id": "S05",
      "beat": 1,
      "text": "Đọc thêm phản hồi của người đăng giúp tách câu đùa khỏi thông tin, trước khi mình kể lại cho người khác.",
      "start_frame": 1542,
      "frames": 148,
      "start_seconds": 51.4,
      "duration_seconds": 4.933333333333334
    },
    {
      "scene_id": "S06",
      "beat": 0,
      "text": "Nếu chỉ thấy bức ảnh lướt qua, bạn nhận ra đây là ảnh đùa ngay, hay cũng phải đọc thêm mới rõ?",
      "start_frame": 1690,
      "frames": 170,
      "start_seconds": 56.333333333333336,
      "duration_seconds": 5.666666666666667
    },
    {
      "scene_id": "S06",
      "beat": 1,
      "text": "Với mình, phần đáng đọc nhất của chuyện này lại nằm ngay dưới bài đăng.",
      "start_frame": 1860,
      "frames": 115,
      "start_seconds": 62.0,
      "duration_seconds": 3.8333333333333335
    }
  ],
