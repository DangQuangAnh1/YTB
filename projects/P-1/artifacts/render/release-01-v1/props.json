 "media": "release-01",
 "hook": "hỏi thăm mẹ mùa lũ, nhận về… thực đơn",
 "cta": "mẹ bạn báo tin kiểu gì?",
 "handle": "@doccmtgium",
 "source_handle": "biu_sub70",
 "sizes": {
  "c1-nhtp.1907_": [
