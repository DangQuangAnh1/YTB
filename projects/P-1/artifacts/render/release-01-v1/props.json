 "fps": 30,
 "duration": 45.923,
 "frames": 1378,
 "lines": [
  {
   "id": "q1",
   "card": "post-biu_sub70",
   "kind": "read",
   "text": "Lũ lên nhà mình có sao không mẹ? Chết ba con gà.",
   "file": "release-01/voice/q1-3e664f0b279e-k1-t1.1.wav",
   "start": 0.5,
   "end": 3.421
  },
  {
   "id": "b1",
   "card": "post-biu_sub70",
   "kind": "bridge",
   "text": "Ba con gà ra đi, nghe đã thấy tang thương. Nhưng khoan, câu tiếp theo mới là bản lĩnh của mẹ.",
   "file": "release-01/voice/b1-2d6d751f365a-k1-t1.1.wav",
   "start": 3.701,
   "end": 8.726
  },
  {
   "id": "q2",
   "card": "post-biu_sub70",
   "kind": "read",
   "text": "Nước ngập vào chuồng hả mẹ? Thịt ra, nấu lẩu!",
   "file": "release-01/voice/q2-83b0b89c15ad-k1-t1.1.wav",
   "start": 9.006,
   "end": 11.629
  },
  {
   "id": "b2",
   "card": "post-biu_sub70",
   "kind": "bridge",
   "text": "Không có mất mát nào cả, chỉ là đổi thực đơn. Mẹ Việt Nam không để thứ gì phí phạm, kể cả nước lũ.",
   "file": "release-01/voice/b2-a125043a69eb-t1.1.wav",
   "start": 12.759,
   "end": 18.366
  },
  {
   "id": "b3",
   "card": "c1-nhtp.1907_",
   "kind": "bridge",
   "text": "Và hóa ra mẹ nhà ai cũng có một phong cách báo tin rất riêng.",
   "file": "release-01/voice/b3-95426ded4dbe-k1-t1.1.wav",
   "start": 18.646,
   "end": 22.002
  },
  {
   "id": "q3",
   "card": "c1-nhtp.1907_",
   "kind": "read",
   "text": "Bà ngoại khỏe chưa mẹ? Rồi. Full HP!",
   "file": "release-01/voice/q3-93f9f40db489-k1-t1.1.wav",
   "start": 22.282,
   "end": 24.835
  },
  {
   "id": "b4",
   "card": "c1-nhtp.1907_",
   "kind": "bridge",
   "text": "Bà ngoại hồi đầy máu, sẵn sàng vào trận. Không biết trận gì, nhưng chắc chắn bà thắng.",
   "file": "release-01/voice/b4-66276d69eb39-t1.1.wav",
   "start": 25.965,
   "end": 30.48
  },
  {
   "id": "b5",
   "card": "c1-nhtp.1907_",
   "kind": "bridge",
   "text": "Cả hội con cái kéo vào điểm danh: mẹ tui cũng y chang, gọi điện giọng như báo tin buồn, hóa ra là gà chết.",
   "file": "release-01/voice/b5-e322515d4b4b-t1.1.wav",
   "start": 30.76,
   "end": 36.374
  },
  {
   "id": "cta",
   "card": "c1-nhtp.1907_",
   "kind": "bridge",
   "text": "Mẹ bạn từng báo tin kiểu gì làm bạn hết hồn? Kể nghe đi, câu hay nhất lên tập sau.",
   "file": "release-01/voice/cta-db4673a884b8-t1.1.wav",
   "start": 36.654,
   "end": 41.323
  }
 ],
