 "lines": [
  {
   "id": "p1",
   "card": "post-_beslynn",
   "kind": "read",
   "text": "Một điều bí mật về đàn ông, nhưng chính đàn ông nói ra:",
   "file": "release-15/voice/p1-845aa091ddd8-t1.1-L20.wav",
   "speaker": "_beslynn",
   "voice": "Trúc Ly",
   "start": 0.1,
   "end": 2.651
  },
  {
   "id": "c1",
   "card": "c1-skytree.1998",
   "kind": "read",
   "text": "Nếu một đứa con trai thân thiết với bạn mà không tỏ tình, thì có khả năng là nó nghèo đấy, éo phải trap đâu. Tiền ăn còn lo không đủ, nó không dám yêu.",
   "file": "release-15/voice/c1-4114234d18a2-t1.1-L20.wav",
   "speaker": "skytree.1998",
   "voice": "Thiện Minh",
   "mutes": [
    [
     6.981,
     7.231
    ]
   ],
   "start": 2.931,
   "end": 10.282
  },
  {
   "id": "q1",
   "card": "c1-skytree.1998",
   "kind": "bridge",
   "text": "Không phải không yêu đâu, chỉ là cái ví không cho phép.",
   "file": "release-15/voice/q1-ea0ea1958cb9-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 12.362,
   "end": 15.282
  },
  {
   "id": "c2",
   "card": "c2-joker_phong",
   "kind": "read",
   "text": "Đàn ông có thể gục ngã vì rất nhiều thứ. Nhưng trước khi gục, phải lết về phòng bằng được. Đóng cửa chốt lại, rồi khóc tu tu.",
   "file": "release-15/voice/c2-564fd9acdfb2-t1.1-L20.wav",
   "speaker": "joker_phong",
   "voice": "Thiền Tâm Đức",
   "start": 15.562,
   "end": 23.93
  },
  {
   "id": "q2",
   "card": "c2-joker_phong",
   "kind": "bridge",
   "text": "Khóc thôi mà cũng phải có quy trình hẳn hoi, chốt cửa trước đã.",
   "file": "release-15/voice/q2-a89bf005608b-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 26.01,
   "end": 29.22
  },
  {
   "id": "c3",
   "card": "c3-cong0098",
   "kind": "read",
   "text": "Tuy lúc nào tao cũng ôm người yêu tao ngủ, nhưng tao muốn là người được ôm.",
   "file": "release-15/voice/c3-07982b4fba3d-k1-t1.1-L20.wav",
   "speaker": "cong0098",
   "voice": "Thái Sơn",
   "start": 29.5,
   "end": 33.145
  },
  {
   "id": "q3",
   "card": "c3-cong0098",
   "kind": "bridge",
   "text": "Ai cũng tưởng mạnh mẽ, hóa ra đàn ông cũng cần được ôm.",
   "file": "release-15/voice/q3-e5483cac5d47-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 33.425,
   "end": 36.419
  },
  {
   "id": "c4",
   "card": "c4-2seventh_of_may",
   "kind": "read",
   "text": "Quên thở nên thở dài, nhưng lại bị kêu là thái độ lòi lõm.",
   "file": "release-15/voice/c4-d1bb4de24666-t1.1-L20.wav",
   "speaker": "2seventh_of_may",
   "voice": "Phạm Tuyên",
   "start": 36.699,
   "end": 39.896
  }
 ],
