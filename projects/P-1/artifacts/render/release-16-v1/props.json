 "lines": [
  {
   "id": "t0",
   "card": "post-ryanken93",
   "kind": "bridge",
   "text": "Bí mật của con gái, phần một!",
   "file": "release-16/voice/t0-cb2f3a4c67da-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 0.1,
   "end": 1.784
  },
  {
   "id": "p1",
   "card": "post-ryanken93",
   "kind": "read",
   "text": "Góc khuất mà con gái luôn giấu diếm.",
   "file": "release-16/voice/p1-e315aacba7cb-t1.1-L20.wav",
   "speaker": "ryanken93",
   "voice": "Thiện Minh",
   "start": 2.064,
   "end": 3.89
  },
  {
   "id": "c1",
   "card": "c1-ryanken93",
   "kind": "read",
   "text": "Con gái từ chối đi chơi, có thể là do chưa gội đầu kịp.",
   "file": "release-16/voice/c1-8cc4834fad33-t1.1-L20.wav",
   "speaker": "ryanken93",
   "voice": "Thiện Minh",
   "start": 4.17,
   "end": 7.079
  },
  {
   "id": "c2",
   "card": "c2-cuzzaihely",
   "kind": "read",
   "text": "Chúng tôi muốn đàn ông có bầu.",
   "file": "release-16/voice/c2-8160a9c1a4f5-t1.1-L20.wav",
   "speaker": "cuzzaihely",
   "voice": "Trúc Ly",
   "start": 7.359,
   "end": 8.752
  },
  {
   "id": "c3",
   "card": "c3-yayii_23",
   "kind": "read",
   "text": "Chúng tôi không chê bạn nghèo, nhưng chúng tôi không thích bạn nhận bản thân mình nghèo.",
   "file": "release-16/voice/c3-53ebdc47947f-t1.1-L20.wav",
   "speaker": "yayii_23",
   "voice": "Ngọc Huyền",
   "start": 10.832,
   "end": 14.553
  },
  {
   "id": "c4",
   "card": "c4-san.s.an",
   "kind": "read",
   "text": "Nếu mà bạn nói gì cô ấy cũng mắc cười, thì là do cô ấy thích bạn, chứ không phải do bạn hài hước.",
   "file": "release-16/voice/c4-ca6bb3255a3e-t1.1-L20.wav",
   "speaker": "san.s.an",
   "voice": "Mai Anh",
   "start": 14.833,
   "end": 20.069
  },
  {
   "id": "c5",
   "card": "c5-letuoc_3333",
   "kind": "read",
   "text": "Một đứa con gái thân thiện quá mức, có vài cư xử khiến bạn lầm tưởng họ thích bạn. Nhưng không đâu, nó chỉ xã giao một cách chân thành.",
   "file": "release-16/voice/c5-ecbede4a53af-k1-t1.1-L20.wav",
   "speaker": "letuoc_3333",
   "voice": "Ngọc Linh",
   "start": 20.649,
   "end": 27.349
  },
  {
   "id": "c6",
   "card": "c6-linweahl_",
   "kind": "read",
   "text": "Nếu mà tao rep tin nhắn nhanh hoặc lỡ mấy phút thì do tao bận, còn năm tiếng rồi chưa rep, thì đừng nhắn nữa nha.",
   "file": "release-16/voice/c6-9bdf38dacdbc-k2-t1.1-L20.wav",
   "speaker": "linweahl_",
   "voice": "Trúc Ly",
   "start": 29.429,
   "end": 34.244
  },
  {
   "id": "c7",
   "card": "c7-nguyenthuydym",
   "kind": "read",
   "text": "Có một sự thật là, tụi tao lại thấy dễ bị cuốn hút bởi mấy thằng hay ít nói, lầm lì, hay ngại ngùng về vấn đề a bê xê, kiểu thấy nó vẫn an toàn hơn là mấy thằng vừa vào nhắn tin đã gạ xếp hình.",
   "file": "release-16/voice/c7-9ee84308df78-t1.1-L20.wav",
   "speaker": "nguyenthuydym",
   "voice": "Ngọc Huyền",
   "start": 34.524,
   "end": 43.846
  },
  {
   "id": "c8",
   "card": "c8-htpl_0601",
   "kind": "read",
   "text": "Chín mươi phần trăm con gái chịu rep tin nhắn nhanh, và ngày nào cũng nhắn với mày, thì nó bật mười cái đèn xanh cho mày rồi đấy, thằng đần ạ.",
   "file": "release-16/voice/c8-be6be60ae874-t1.1-L20.wav",
   "speaker": "htpl_0601",
   "voice": "Mai Anh",
   "start": 44.126,
   "end": 51.561
  },
  {
   "id": "z1",
   "card": "c8-htpl_0601",
   "kind": "bridge",
   "text": "Phần hai có ngay trên kênh, nhớ theo dõi nha!",
   "file": "release-16/voice/z1-cf642c9a2f5b-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 53.841,
   "end": 56.309
  }
 ],
