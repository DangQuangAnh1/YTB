 "lines": [
  {
   "id": "t0",
   "card": "post-d.thyu._",
   "kind": "bridge",
   "text": "Điều gì khiến mày nhớ mãi một ngày nào đó trong cuộc đời mày?",
   "file": "release-23/voice/t0-545720d4ead3-t1.15-L20.wav",
   "speaker": "narrator",
   "voice": "Phạm Tuyên",
   "start": 0.1,
   "end": 2.966
  },
  {
   "id": "c1",
   "card": "c1-aries_with_a_brave_heart",
   "kind": "read",
   "text": "Chưa quên người yêu cũ. Ảnh bị ung thư máu, mất năm hai không hai hai.",
   "file": "release-23/voice/c1-686e24045dbc-t1.15-L20.wav",
   "speaker": "aries_with_a_brave_heart",
   "voice": "Trúc Ly",
   "start": 3.516,
   "end": 6.581
  },
  {
   "id": "c2",
   "card": "c2-trongtfixer",
   "kind": "read",
   "text": "Lúc mà tui xuống thăm vợ hụt lần cuối. Ẻm bị bệnh viện trả về vì ung thư di căn vào xương. Hôm đó trên xe xuống mà lòng buồn kinh khủng, ghé trạm dừng cũng chẳng buồn xuống xe, chỉ mong xe đi thật nhanh. Xuống tới nhà ẻm thì thấy ẻm nằm đó với mớ ống truyền nước, ống ô xi thì đã được rút ra rồi, nhưng ẻm cứ nằm chảy nước mắt, mạch thì vẫn còn. Vội vàng chạy lại đeo nhẫn cưới cho ẻm, nói với ẻm: nhẫn cưới anh đeo cho em rồi nè, em chính thức thành vợ anh rồi nghen, yên tâm ngủ nè, anh thương. Nói xong thì năm phút sau, ẻm đi.",
   "file": "release-23/voice/c2-8d1ae43e4b79-t1.15-L20.wav",
   "speaker": "trongtfixer",
   "voice": "Thiện Minh",
   "start": 7.131,
   "end": 32.963
  },
  {
   "id": "c3",
   "card": "c3-dulcieeejadeeee_",
   "kind": "read",
   "text": "Mười hai tháng năm, mình hí hửng khoe bố và cả nhà, con đi xem Nhà Gia Tiên, khóc nức nở thương nhân vật người ba trong phim, còn chụp ảnh đăng lên để khen bố. Ba giờ sáng mười ba tháng năm, mẹ gọi báo: bố mất rồi con. Lục tung phòng, soạn gấp hai cái vali chả có gì bên trong, gấp bay về với bố. Bảy rưỡi sáng, ra sân bay một mình, khóc ở sân bay như đứa trẻ lên ba. Mười bốn tháng năm, bốn rưỡi chiều giờ Việt Nam, em gái nhắn: bố trút hơi thở cuối cùng lúc bốn rưỡi chiều. Gia đình mình mãi hạnh phúc nha các chị.",
   "file": "release-23/voice/c3-e49f9c72b5fb-k1-t1.15-L20.wav",
   "speaker": "dulcieeejadeeee_",
   "voice": "Ngọc Huyền",
   "start": 33.513,
   "end": 58.675
  },
  {
   "id": "z1",
   "card": "c3-dulcieeejadeeee_",
   "kind": "bridge",
   "text": "Còn bạn, ngày nào khiến bạn nhớ mãi? Kể mình nghe nha.",
   "file": "release-23/voice/z1-689f0ea90357-t1.15-L20.wav",
   "speaker": "narrator",
   "voice": "Phạm Tuyên",
   "start": 59.225,
   "end": 61.885
  }
 ],
