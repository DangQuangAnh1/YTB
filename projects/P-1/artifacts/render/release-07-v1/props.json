 "duration": 37.084,
 "frames": 1113,
 "lines": [
  {
   "id": "cold",
   "card": "post-m0ichanchan",
   "kind": "bridge",
   "text": "Cưới nhau mười chín năm, bố vẫn nhắn cho mẹ đúng một câu quen thuộc:",
   "file": "release-07/voice/cold-a989a0237528-t1.1.wav",
   "start": 0.5,
   "end": 3.931
  },
  {
   "id": "q1",
   "card": "post-m0ichanchan",
   "kind": "read",
   "text": "Em ăn cơm chưa.",
   "file": "release-07/voice/q1-f15fabe36d48-t1.1.wav",
   "start": 4.211,
   "end": 5.313
  },
  {
   "id": "b1",
   "card": "post-m0ichanchan",
   "kind": "bridge",
   "text": "Nhưng nhìn kỹ góc trên: thông báo tin nhắn của bố… đã bị mẹ tắt.",
   "file": "release-07/voice/b1-ccda8e051586-t1.1.wav",
   "start": 6.443,
   "end": 9.87
  },
  {
   "id": "b2",
   "card": "c1-dv.hqang_",
   "kind": "bridge",
   "text": "Cư dân mạng xót xa: sao mẹ lại tắt thông báo của bố?",
   "file": "release-07/voice/b2-230b8c04c578-t1.1.wav",
   "start": 10.15,
   "end": 13.214
  },
  {
   "id": "q2",
   "card": "c1a-user171107374920",
   "kind": "read",
   "text": "Chắc năm phút hỏi em ăn cơm chưa một lần.",
   "file": "release-07/voice/q2-57c513e74e24-t1.1.wav",
   "start": 13.494,
   "end": 15.674
  },
  {
   "id": "b3",
   "card": "c1b-m0ichanchan",
   "kind": "bridge",
   "text": "Tác giả tiết lộ: mẹ tắt cả thông báo của con luôn. Vậy mà bố vừa nhắn, mẹ vẫn biết để trả lời ngay.",
   "file": "release-07/voice/b3-b062885993c2-t1.1.wav",
   "start": 16.804,
   "end": 22.184
  },
  {
   "id": "b4",
   "card": "c2-m0ichanchan",
   "kind": "bridge",
   "text": "Và câu trả lời của mẹ, sau mười chín năm, vẫn gọn như thế:",
   "file": "release-07/voice/b4-5d3752850dd1-k1-t1.1.wav",
   "start": 22.464,
   "end": 25.967
  },
  {
   "id": "q3",
   "card": "c2-m0ichanchan",
   "kind": "read",
   "text": "Em ăn rồi.",
   "file": "release-07/voice/q3-c8dbf5333960-k2-t1.1.wav",
   "start": 26.247,
   "end": 27.056
  },
  {
   "id": "cta",
   "card": "c2-m0ichanchan",
   "kind": "bridge",
   "text": "Bố mẹ bạn hay nhắn cho nhau câu gì nhất? Kể nghe đi, câu hay nhất lên tập sau.",
   "file": "release-07/voice/cta-38b38f8b1b72-t1.1.wav",
   "start": 28.186,
   "end": 32.484
  }
 ],
