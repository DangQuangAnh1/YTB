 "duration": 61,
 "frames": 1830,
 "lines": [
  {
   "id": "intro",
   "card": "post-karis.like.sleep7",
   "kind": "bridge",
   "text": "Có một bài đăng xin mọi người để lại những câu văn hay nhất từng đọc. Hơn một nghìn người đã trả lời.",
   "file": "prototype-07/voice/intro-998e49b0d50c.wav",
   "start": 0.5,
   "end": 7.7
  },
  {
   "id": "c1",
   "card": "c1-trgmn_.ig",
   "kind": "read",
   "text": "Viết cho ta, những người quen thành lạ. Vẫn là mùa hạ, nhưng không còn chúng ta.",
   "file": "prototype-07/voice/c1-fd266b8aa0cf.wav",
   "start": 8.25,
   "end": 14.33
  },
  {
   "id": "c1r",
   "card": "c1r-karis.like.sleep7",
   "kind": "read",
   "text": "Văn đẹp mà buồn quá.",
   "file": "prototype-07/voice/c1r-b5a0ea47e721.wav",
   "start": 14.88,
   "end": 16.48
  },
  {
   "id": "c2",
   "card": "c2-_sue.le",
   "kind": "read",
   "text": "Hoa cầm trên tay vẫn là của đất. Người giữ trong lòng, long trời lở đất, vẫn là người dưng.",
   "file": "prototype-07/voice/c2-d4a33858e6fb.wav",
   "start": 17.03,
   "end": 23.67
  },
  {
   "id": "b3",
   "card": "c3-loveislove.197_",
   "kind": "bridge",
   "text": "Có người lại nhớ nhà.",
   "file": "prototype-07/voice/b3-6d3a6781befe.wav",
   "start": 24.22,
   "end": 25.9
  },
  {
   "id": "c3",
   "card": "c3-loveislove.197_",
   "kind": "read",
   "text": "Nỗi nhớ nhà sẽ khiến bạn nhận ra rằng, chúng ta luôn có thể yêu thương từ một nơi rất xa.",
   "file": "prototype-07/voice/c3-3d6255f39d2d.wav",
   "start": 26.45,
   "end": 32.77
  },
  {
   "id": "c4",
   "card": "c4-_pon.05",
   "kind": "read",
   "text": "Chớp mắt một cái thôi, cũng đã qua nửa đời người. Hà cớ gì phải phí thời giờ, giận hờn một điều gì đó xa xôi.",
   "file": "prototype-07/voice/c4-e04683c13aad.wav",
   "start": 33.32,
   "end": 41.48
  },
  {
   "id": "c5",
   "card": "c5-nthtrann20",
   "kind": "read",
   "text": "Có những ngày vất vả, tôi và cuộc đời tự tha thứ cho nhau.",
   "file": "prototype-07/voice/c5-bbbbb286ff8e.wav",
   "start": 42.03,
   "end": 47.39
  },
  {
   "id": "b6",
   "card": "c6-thukwon0512",
   "kind": "bridge",
   "text": "Và câu cuối, dành cho những ngày bạn thấy mình chạm đáy.",
   "file": "prototype-07/voice/b6-347aa49c9230.wav",
   "start": 47.94,
   "end": 51.78
  },
  {
   "id": "c6",
   "card": "c6-thukwon0512",
   "kind": "read",
   "text": "Khi cuộc đời của bạn chạm đáy, thì bước nào cũng là bước lên.",
   "file": "prototype-07/voice/c6-daa33f1d2d0f.wav",
   "start": 52.33,
   "end": 56.49
  },
  {
   "id": "cta",
   "card": "c6-thukwon0512",
   "kind": "bridge",
   "text": "Câu nào chạm vào bạn nhất?",
   "file": "prototype-07/voice/cta-cd19058e8304.wav",
   "start": 57.04,
   "end": 58.8
  }
 ],
