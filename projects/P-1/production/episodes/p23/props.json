 "lines": [
  {
   "id": "p1",
   "card": "post-phailamqualo",
   "kind": "read",
   "text": "Bí mật của con gái mà con trai không biết. Chúng tôi đọc và không đánh giá.",
   "file": "release-14/voice/p1-daa7b7dcc08e-t1.1-L20.wav",
   "speaker": "phailamqualo",
   "voice": "Thiện Minh",
   "start": 0.1,
   "end": 3.741
  },
  {
   "id": "c1",
   "card": "c1-maisemayman",
   "kind": "read",
   "text": "Con gái đi chơi với con gái sẽ ăn diện và make up kì công hơn so với đi cùng người yêu.",
   "file": "release-14/voice/c1-ee43f6ec699f-k1-t1.1-L20.wav",
   "speaker": "maisemayman",
   "voice": "Trúc Ly",
   "start": 4.021,
   "end": 7.738
  },
  {
   "id": "q1",
   "card": "c1-maisemayman",
   "kind": "bridge",
   "text": "Vậy ra người yêu chỉ được xem bản nháp thôi à.",
   "file": "release-14/voice/q1-4e41fcc50e74-k1-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 9.818,
   "end": 12.227
  },
  {
   "id": "c2",
   "card": "c2-pomersum",
   "kind": "read",
   "text": "Chúng tôi thực sự cần một bạn trai biết chụp ảnh cho chúng tôi!",
   "file": "release-14/voice/c2-ce45c246db77-t1.1-L20.wav",
   "speaker": "pomersum",
   "voice": "Ngọc Huyền",
   "start": 12.507,
   "end": 15.498
  },
  {
   "id": "q2",
   "card": "c2-pomersum",
   "kind": "bridge",
   "text": "Anh em nào chụp ảnh xấu, tự giác giơ tay.",
   "file": "release-14/voice/q2-b62ae8ea0ebc-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 16.078,
   "end": 18.481
  },
  {
   "id": "c3",
   "card": "c3-mohonthichchu",
   "kind": "read",
   "text": "Chín mươi phần trăm các anh tán đổ các chị em, là vì chị em chúng tôi cũng có thích thích, bật đèn xanh cho các anh.",
   "file": "release-14/voice/c3-08b0b2267b98-t1.1-L20.wav",
   "speaker": "mohonthichchu",
   "voice": "Mai Anh",
   "start": 18.761,
   "end": 25.155
  },
  {
   "id": "q3",
   "card": "c3-mohonthichchu",
   "kind": "bridge",
   "text": "Hóa ra từ trước tới giờ, các anh chưa từng thắng.",
   "file": "release-14/voice/q3-a8c978636f39-k1-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 27.235,
   "end": 29.864
  },
  {
   "id": "q4",
   "card": "c4-hung171023",
   "kind": "bridge",
   "text": "Còn một anh thì tiết lộ: các chị đã nhắm sẵn từ trước, rồi mới bật đèn xanh cho anh tưởng mình tán đổ.",
   "file": "release-14/voice/q4-8384d1a87651-k2-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 30.144,
   "end": 35.677
  },
  {
   "id": "c4",
   "card": "c4-hung171023",
   "kind": "read",
   "text": "Chứ các chị em mà không chấm, thì mãn kiếp các anh cũng không tán được.",
   "file": "release-14/voice/c4-e30255b69bba-k1-t1.1-L20.wav",
   "speaker": "hung171023",
   "voice": "Thiền Tâm Đức",
   "start": 35.957,
   "end": 40.261
  }
 ],
