 "lines": [
  {
   "id": "p1",
   "card": "post-hoangphuc.ig",
   "kind": "read",
   "text": "Tao thật sự thắc mắc, làm thế nào mà bọn mày có người yêu hay vậy?",
   "file": "release-10/voice/p1-70cd848d0b0c-t1.1-L20.wav",
   "speaker": "hoangphuc.ig",
   "voice": "Thiện Minh",
   "start": 0.1,
   "end": 3.245
  },
  {
   "id": "a1",
   "card": "c1-_nghilee.zs_",
   "kind": "bridge",
   "text": "Và câu trả lời được nhiều tim nhất là:",
   "file": "release-10/voice/a1-248031539886-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 3.525,
   "end": 5.622
  },
  {
   "id": "c1",
   "card": "c1-_nghilee.zs_",
   "kind": "read",
   "text": "Độc thân là do gia tiên đang bảo vệ bạn khỏi những điều tệ hại.",
   "file": "release-10/voice/c1-b2dd91919217-t1.1-L20.wav",
   "speaker": "_nghilee.zs_",
   "voice": "Ngọc Huyền",
   "start": 5.902,
   "end": 8.896
  },
  {
   "id": "c1a",
   "card": "c1a-hoangphuc.ig",
   "kind": "read",
   "text": "Nếu đúng vậy thì tuyệt quá nhỉ.",
   "file": "release-10/voice/c1a-4c84e33e2728-t1.1-L20.wav",
   "speaker": "hoangphuc.ig",
   "voice": "Thiện Minh",
   "start": 10.776,
   "end": 12.459
  },
  {
   "id": "a2",
   "card": "c2-huali_nh",
   "kind": "bridge",
   "text": "Có người còn phân tích hẳn hoi:",
   "file": "release-10/voice/a2-efa4c3ffc1b5-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 12.739,
   "end": 14.635
  },
  {
   "id": "c2",
   "card": "c2-huali_nh",
   "kind": "read",
   "text": "Hai lí do chủ yếu. Một là gia tiên nhà mình chưa cho yêu. Hai là gia tiên nhà người ta chưa chấm mình. Còn không phải hai cái đó, thì do thực lực. Ế bằng thực lực.",
   "file": "release-10/voice/c2-69697f1ce412-t1.1-L20.wav",
   "speaker": "huali_nh",
   "voice": "Mai Anh",
   "start": 14.915,
   "end": 23.939
  },
  {
   "id": "a3",
   "card": "c3-wn_lein",
   "kind": "bridge",
   "text": "Còn đây là bí kíp của một bạn khác:",
   "file": "release-10/voice/a3-dd90404de4ba-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 26.119,
   "end": 28.018
  },
  {
   "id": "c3",
   "card": "c3-wn_lein",
   "kind": "read",
   "text": "Tao ngồi im, nó tự tìm tới tao.",
   "file": "release-10/voice/c3-ffec79bf3707-k1-t1.1-L20.wav",
   "speaker": "wn_lein",
   "voice": "Trúc Ly",
   "start": 28.298,
   "end": 29.978
  },
  {
   "id": "a4",
   "card": "c3a-hoangphuc.ig",
   "kind": "bridge",
   "text": "Chủ bài đáp lại một câu đau lòng:",
   "file": "release-10/voice/a4-7c45023234ec-k2-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 30.258,
   "end": 32.16
  },
  {
   "id": "c3a",
   "card": "c3a-hoangphuc.ig",
   "kind": "read",
   "text": "Còn tao ngồi im, nó tự tìm tới người khác.",
   "file": "release-10/voice/c3a-4973f551c163-t1.1-L20.wav",
   "speaker": "hoangphuc.ig",
   "voice": "Thiện Minh",
   "start": 32.44,
   "end": 34.465
  }
 ],
