    },
    {
      "id": "c1",
      "card": "c1-skytree.1998",
      "kind": "read",
      "text": "Nếu một đứa con trai thân thiết với bạn mà không tỏ tình, thì có khả năng là nó nghèo đấy, éo phải trap đâu. Tiền ăn còn lo không đủ, nó không dám yêu.",
      "bleep": [
