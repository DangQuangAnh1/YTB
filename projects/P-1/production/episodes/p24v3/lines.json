        "đm"
      ]
    },
    {
      "id": "c6",
      "card": "c6-hung_n89",
      "kind": "read",
      "text": "Miếng da bọc hai hòn tự lột mỗi tháng."
    },
    {
      "id": "c6a",
      "card": "c6a-ngp_jake",
      "kind": "read",
      "text": "Do ba hong rửa chứ ngày nào mà hong có."
    },
    {
      "id": "c6b",
      "card": "c6b-peter_khqng",
      "kind": "read",
      "text": "Sao lại tiết lộ bí mật quốc gia?"
    },
    {
      "id": "c6c",
      "card": "c6c-leeanhtuaans",
      "kind": "read",
      "text": "Đm, chim ông hoá thạch à?",
