 "lines": [
  {
   "id": "t0",
   "card": "post-_beslynn",
   "kind": "bridge",
   "text": "Bí mật của con trai, phần một!",
   "file": "release-15/voice/t0-a3c31cddbf8c-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 0.1,
   "end": 2.077
  },
  {
   "id": "p1",
   "card": "post-_beslynn",
   "kind": "read",
   "text": "Một điều bí mật về đàn ông, nhưng chính đàn ông nói ra:",
   "file": "release-15/voice/p1-845aa091ddd8-t1.1-L20.wav",
   "speaker": "_beslynn",
   "voice": "Trúc Ly",
   "start": 2.357,
   "end": 4.908
  },
  {
   "id": "c5",
   "card": "c5-thienvy1106",
   "kind": "read",
   "text": "Con trai thích skinship với nhau, nhưng mà không thích con gái động vô người nó.",
   "file": "release-15/voice/c5-30d9278c676b-k1-t1.1-L20.wav",
   "speaker": "thienvy1106",
   "voice": "Ngọc Huyền",
   "start": 5.188,
   "end": 8.984
  },
  {
   "id": "c5a",
   "card": "c5a-voidphong1995",
   "kind": "read",
   "text": "Thôi đm, ông bị gay rồi.",
   "file": "release-15/voice/c5a-856fdb29d0f1-t1.1-L20.wav",
   "speaker": "voidphong1995",
   "voice": "Thái Sơn",
   "mutes": [
    [
     9.494,
     10.154
    ]
   ],
   "start": 9.264,
   "end": 11.024
  },
  {
   "id": "c6",
   "card": "c6-hung_n89",
   "kind": "read",
   "text": "Miếng da bọc hai hòn tự lột mỗi tháng.",
   "file": "release-15/voice/c6-7cae4af29d0a-k1-t1.1-L20.wav",
   "speaker": "hung_n89",
   "voice": "Thiện Minh",
   "start": 11.304,
   "end": 13.271
  },
  {
   "id": "c6a",
   "card": "c6a-ngp_jake",
   "kind": "read",
   "text": "Do ba hong rửa chứ ngày nào mà hong có.",
   "file": "release-15/voice/c6a-985396b60258-t1.1-L20.wav",
   "speaker": "ngp_jake",
   "voice": "Phạm Tuyên",
   "start": 13.551,
   "end": 15.74
  },
  {
   "id": "c6b",
   "card": "c6b-peter_khqng",
   "kind": "read",
   "text": "Sao lại tiết lộ bí mật quốc gia?",
   "file": "release-15/voice/c6b-8e823dd3a7dc-t1.1-L20.wav",
   "speaker": "peter_khqng",
   "voice": "Quốc Tuấn",
   "start": 16.02,
   "end": 17.702
  },
  {
   "id": "c6c",
   "card": "c6c-leeanhtuaans",
   "kind": "read",
   "text": "Đm, chim ông hoá thạch à?",
   "file": "release-15/voice/c6c-b1a13092ff55-t1.1-L20.wav",
   "speaker": "leeanhtuaans",
   "voice": "Hải Đăng",
   "mutes": [
    [
     17.992,
     18.412
    ],
    [
     18.252,
     18.822
    ]
   ],
   "start": 17.982,
   "end": 19.735
  },
  {
   "id": "c2",
   "card": "c2-joker_phong",
   "kind": "read",
   "text": "Đàn ông có thể gục ngã vì rất nhiều thứ. Nhưng trước khi gục, phải lết về phòng bằng được. Đóng cửa chốt lại, rồi có thể ngồi nằm ngay cửa mà khóc tu tu.",
   "file": "release-15/voice/c2-8e88b52b0c9c-t1.1-L20.wav",
   "speaker": "joker_phong",
   "voice": "Thiền Tâm Đức",
   "start": 21.915,
   "end": 32.249
  },
  {
   "id": "c7",
   "card": "c7-trungzin",
   "kind": "read",
   "text": "Đi mua đồ về, xong sẽ khai thấp hơn mức tiền thực trả.",
   "file": "release-15/voice/c7-ec4c29859830-t1.1-L20.wav",
   "speaker": "trungzin",
   "voice": "Hải Đăng",
   "start": 32.529,
   "end": 35.164
  },
  {
   "id": "c8",
   "card": "c8-peter_khqng",
   "kind": "read",
   "text": "Có sở thích nuôi lông jimz để cho nó dài dài nghịch đã.",
   "file": "release-15/voice/c8-bda9ad3cce42-k1-t1.1-L20.wav",
   "speaker": "peter_khqng",
   "voice": "Quốc Tuấn",
   "mutes": [
    [
     36.724,
     37.074
    ]
   ],
   "start": 35.744,
   "end": 38.74
  },
  {
   "id": "c9",
   "card": "c9-tran.dinhkhiem",
   "kind": "read",
   "text": "Lọ bốn phát rồi, ráng lên sân cầu lông đánh bốn tiếng, vắt khô.",
   "file": "release-15/voice/c9-fcd2eae012a7-t1.1-L20.wav",
   "speaker": "tran.dinhkhiem",
   "voice": "Thái Sơn",
   "mutes": [
    [
     38.94,
     39.3
    ]
   ],
   "start": 39.02,
   "end": 42.657
  },
  {
   "id": "c10",
   "card": "c10-hieuminh4080",
   "kind": "read",
   "text": "Hồi bé tao từng chạy lên trường cấp ba chơi, mà lúc đó nhỏ, tưởng bồn đái cho con trai là để ỉa, rồi tao ỉa một bãi to lên đấy.",
   "file": "release-15/voice/c10-a9eb37fb76cd-t1.1-L20.wav",
   "speaker": "hieuminh4080",
   "voice": "Phạm Tuyên",
   "mutes": [
    [
     49.937,
     50.247
    ]
   ],
   "start": 44.737,
   "end": 51.582
  },
  {
   "id": "c11",
   "card": "c11-tnlien.o6",
   "kind": "read",
   "text": "Thật ra tao là con trai, xin lỗi đã giấu quả bí mật này quá lâu rồi.",
   "file": "release-15/voice/c11-90e22a4c6821-t1.1-L20.wav",
   "speaker": "tnlien.o6",
   "voice": "Thiện Minh",
   "start": 51.862,
   "end": 55.578
  },
  {
   "id": "c1",
   "card": "c1-skytree.1998",
   "kind": "read",
   "text": "Nếu một đứa con trai thân thiết với bạn mà không tỏ tình, thì có khả năng là nó nghèo đấy, éo phải trap đâu. Tiền ăn còn lo không đủ, nó không dám yêu.",
   "file": "release-15/voice/c1-4114234d18a2-t1.1-L20.wav",
   "speaker": "skytree.1998",
   "voice": "Thiện Minh",
   "mutes": [
    [
     60.208,
     60.458
    ]
   ],
   "start": 56.158,
   "end": 63.509
  },
  {
   "id": "z1",
   "card": "c1-skytree.1998",
   "kind": "bridge",
   "text": "Phần hai có ngay trên kênh, nhớ theo dõi nha!",
   "file": "release-15/voice/z1-cf642c9a2f5b-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 65.889,
   "end": 68.448
  }
 ],
