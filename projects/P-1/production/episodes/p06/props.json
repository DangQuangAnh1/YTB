 "lines": [
  {
   "id": "intro",
   "card": "post-bittercake_swee",
   "kind": "bridge",
   "text": "Mẹ vừa chuyển tiền tiêu tháng này, bạn này lên Threads nhờ cả mạng nghĩ giùm một câu cảm ơn cho ngầu.",
   "file": "prototype-06/voice/intro-108a84b061ba-t1.1.wav",
   "start": 0.5,
   "end": 5.67
  },
  {
   "id": "b1",
   "card": "c1-benicutexiu_29",
   "kind": "bridge",
   "text": "Câu được thả tim nhiều nhất là.",
   "file": "prototype-06/voice/b1-fa722c73c343-t1.1.wav",
   "start": 5.95,
   "end": 7.701
  },
  {
   "id": "c1",
   "card": "c1-benicutexiu_29",
   "kind": "read",
   "text": "Nào rảnh cà phê.",
   "file": "prototype-06/voice/c1-26113a35f0df-t1.1.wav",
   "start": 7.981,
   "end": 9.085
  },
  {
   "id": "c1r",
   "card": "c1r-tn.qang",
   "kind": "read",
   "text": "Bà cố nội này.",
   "file": "prototype-06/voice/c1r-5d858532d7fd-t1.1.wav",
   "start": 9.365,
   "end": 10.472
  },
  {
   "id": "b2",
   "card": "c2-deertomars",
   "kind": "bridge",
   "text": "Có người còn sửa luôn ca dao.",
   "file": "prototype-06/voice/b2-6b17cb27030d-t1.1.wav",
   "start": 11.602,
   "end": 13.353
  },
  {
   "id": "c2a",
   "card": "c2-deertomars",
   "kind": "read",
   "text": "Công cha như núi Thái Sơn, nghĩa mẹ như nước trong nguồn chảy ra. Một lòng thờ mẹ kính cha.",
   "file": "prototype-06/voice/c2a-ae8b7e561629-t1.1.wav",
   "start": 13.633,
   "end": 18.587
  },
  {
   "id": "c2b",
   "card": "c2-deertomars",
   "kind": "read",
   "text": "Tiền con con giữ, tiền mẹ con xin.",
   "file": "prototype-06/voice/c2b-1f2c5d94c799-t1.1.wav",
   "start": 19.317,
   "end": 21.436
  },
  {
   "id": "b3",
   "card": "c3-victoryy01011",
   "kind": "bridge",
   "text": "Bản ngắn gọn có vần thì đây.",
   "file": "prototype-06/voice/b3-df6ead7e0de4-t1.1.wav",
   "start": 22.566,
   "end": 24.321
  },
  {
   "id": "c3",
   "card": "c3-victoryy01011",
   "kind": "read",
   "text": "Tiền đã về ví, lòng cho về nhà, cảm ơn mẹ nha!",
   "file": "prototype-06/voice/c3-0386de40b72c-t1.1.wav",
   "start": 24.601,
   "end": 27.523
  },
  {
   "id": "b4",
   "card": "c5-nhincaigi4142",
   "kind": "bridge",
   "text": "Phe cổ trang cũng không chịu thua.",
   "file": "prototype-06/voice/b4-3ff5d687cd8a-t1.1.wav",
   "start": 27.803,
   "end": 29.854
  },
  {
   "id": "c5",
   "card": "c5-nhincaigi4142",
   "kind": "read",
   "text": "Tạ ơn mẫu thân đã ban thưởng, hài nhi xin phép cáo lui.",
   "file": "prototype-06/voice/c5-4a35b9c916b2-t1.1.wav",
   "start": 30.134,
   "end": 33.265
  },
  {
   "id": "b5",
   "card": "c4-myracle404",
   "kind": "bridge",
   "text": "Nhưng đỉnh nhất là người không có mẫu cảm ơn, mà có sẵn mẫu xin tiền.",
   "file": "prototype-06/voice/b5-5ce4c71fcee7-t1.1.wav",
   "start": 34.395,
   "end": 38.187
  },
  {
   "id": "c4",
   "card": "c4-myracle404",
   "kind": "read",
   "text": "Mẹ ơi mẹ đẹp như tiên, mẹ thêm dấu huyền mẹ gửi cho con.",
   "file": "prototype-06/voice/c4-2f44b32717d2-t1.1.wav",
   "start": 38.467,
   "end": 41.604
  },
  {
   "id": "c6",
   "card": "c6-_ym.art_17",
   "kind": "read",
   "text": "Bác đừng xoá post nhé, để mỗi lần xin tiền tui vào lấy một câu.",
   "file": "prototype-06/voice/c6-ae0e5efb5760-t1.1.wav",
   "start": 42.734,
   "end": 46.306
  },
  {
   "id": "cta",
   "card": "c6-_ym.art_17",
   "kind": "bridge",
   "text": "Còn bạn, sẽ rep mẹ câu nào?",
   "file": "prototype-06/voice/cta-a9dab8a7b93a-t1.1.wav",
   "start": 46.586,
   "end": 48.421
  }
 ],
