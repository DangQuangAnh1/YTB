 "duration": 57.675,
 "frames": 1731,
 "lines": [
  {
   "id": "cold",
   "card": "post-_lysl0v3r",
   "kind": "bridge",
   "text": "Đi du lịch Đức, đứng giữa sân vận động khủng nhất nước, con gái hí hửng chụp ảnh khoe mẹ.",
   "file": "release-05/voice/cold-87ffdc0780d6-t1.1.wav",
   "start": 0.5,
   "end": 4.931
  },
  {
   "id": "b1",
   "card": "photo-_lysl0v3r",
   "kind": "bridge",
   "text": "Sân A-li-anh A-rê-na, nhà của Bai-ơn Muy-ních, hơn bảy mươi nghìn chỗ ngồi.",
   "file": "release-05/voice/b1-d55646090320-t1.1.wav",
   "start": 5.211,
   "end": 10.23
  },
  {
   "id": "b2",
   "card": "chat-_lysl0v3r",
   "kind": "bridge",
   "text": "Con khen sân to đùng. Mẹ đáp ngay một câu đầy tự hào:",
   "file": "release-05/voice/b2-20fe7263e81f-k1-t1.1.wav",
   "start": 10.51,
   "end": 13.723
  },
  {
   "id": "q1",
   "card": "chat-_lysl0v3r",
   "kind": "read",
   "text": "Việt Nam đang xây sân bóng đá to nhất thế giới đấy con ạ.",
   "file": "release-05/voice/q1-fc17fe63af8a-k1-t1.1.wav",
   "start": 14.003,
   "end": 17.067
  },
  {
   "id": "b3",
   "card": "chat-_lysl0v3r",
   "kind": "bridge",
   "text": "Con hỏi sân đó ở đâu. Mẹ né, rồi chốt hạ một câu xanh rờn:",
   "file": "release-05/voice/b3-60aa952081ee-t1.1.wav",
   "start": 17.347,
   "end": 20.993
  },
  {
   "id": "q2",
   "card": "chat-_lysl0v3r",
   "kind": "read",
   "text": "Chả có vẹo gì.",
   "file": "release-05/voice/q2-7dd3d67d9814-k4-t1.1.wav",
   "start": 21.273,
   "end": 22.445
  },
  {
   "id": "b4",
   "card": "c1-thuyflinh_88",
   "kind": "bridge",
   "text": "Cư dân mạng vội nhắc mẹ: đây là sân nhà của Bai-ơn Muy-ních đấy ạ.",
   "file": "release-05/voice/b4-2bb7c87002c9-k1-t1.1.wav",
   "start": 23.575,
   "end": 26.924
  },
  {
   "id": "b5",
   "card": "c1a-_lysl0v3r",
   "kind": "bridge",
   "text": "Tác giả đành gật gù: ừ thì, sân Bai-ơn nhé.",
   "file": "release-05/voice/b5-6e151e4fe100-k1-t1.1.wav",
   "start": 27.204,
   "end": 30.051
  },
  {
   "id": "b6",
   "card": "c2-trnhnglm",
   "kind": "bridge",
   "text": "Nhưng có người đã nhập vai mẹ cực chuẩn:",
   "file": "release-05/voice/b6-4c00863dde84-t1.1.wav",
   "start": 30.331,
   "end": 32.452
  },
  {
   "id": "q3",
   "card": "c2-trnhnglm",
   "kind": "read",
   "text": "À là cái đội mà đá cúp xê một vừa hòa một đội cù lao nào bên Na Uy đó hả? Cũng chả có cái vẹo gì.",
   "file": "release-05/voice/q3-9e6f0de574a7-k2-t1.1.wav",
   "start": 32.732,
   "end": 38.492
  },
  {
   "id": "b7",
   "card": "c3-kemkem_vani_",
   "kind": "bridge",
   "text": "Hóa ra mẹ nhà ai cũng vậy. Có mẹ đi Thượng Hải về, chê còn chán hơn bãi đá sông Hồng.",
   "file": "release-05/voice/b7-463a460f9855-t1.1.wav",
   "start": 39.622,
   "end": 44.213
  },
  {
   "id": "b8",
   "card": "c3a-jssy.ng",
   "kind": "bridge",
   "text": "Có mẹ đứng trước tòa Vũ Khang, phán gọn: không bằng ngã tư Chùa Bộc.",
   "file": "release-05/voice/b8-eb14273fe267-k1-t1.1.wav",
   "start": 44.493,
   "end": 48.06
  },
  {
   "id": "cta",
   "card": "c3a-jssy.ng",
   "kind": "bridge",
   "text": "Mẹ bạn từng chê địa danh nổi tiếng nào chưa? Kể nghe đi, câu hay nhất lên tập sau.",
   "file": "release-05/voice/cta-c41ea8f0f55a-k1-t1.1.wav",
   "start": 48.34,
   "end": 53.075
  }
 ],
