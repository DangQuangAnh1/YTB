 "lines": [
  {
   "id": "t0",
   "card": "post-jewy_aa",
   "kind": "bridge",
   "text": "Bí mật của con gái, phần ba!",
   "file": "release-21/voice/t0-bc128ba3a5d5-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 0.1,
   "end": 1.932
  },
  {
   "id": "p1",
   "card": "post-jewy_aa",
   "kind": "read",
   "text": "Topic: Ê, tao muốn nghe các sự thật về con gái, từ chính miệng con gái á.",
   "file": "release-21/voice/p1-ceedc139b1ac-k2-t1.1-L20.wav",
   "speaker": "jewy_aa",
   "voice": "Ngọc Huyền",
   "start": 2.212,
   "end": 6.226
  },
  {
   "id": "c6",
   "card": "c6-tnhiikhoivu",
   "kind": "read",
   "text": "Top một: muốn đàn ông có bầu. Top hai: muốn mọc chim. Top ba: muốn cặp đôi gay cưới nhau.",
   "file": "release-21/voice/c6-ed67e4640310-k2-t1.1-L20.wav",
   "speaker": "tnhiikhoivu",
   "voice": "Trúc Ly",
   "mutes": [
    [
     8.456,
     9.076
    ]
   ],
   "start": 6.506,
   "end": 10.511
  },
  {
   "id": "c7",
   "card": "c7-hayu.f24",
   "kind": "read",
   "text": "Mua ly trà sữa ba lăm nghìn chê đắt, thấy đồ thần tượng ba trăm năm mươi nghìn khen rẻ. Mua cây son trăm rưỡi suy nghĩ hai tháng, hốt cái vé xem ca nhạc một triệu rưỡi, hai giây.",
   "file": "release-21/voice/c7-9bd17df141f8-t1.1-L20.wav",
   "speaker": "hayu.f24",
   "voice": "Mai Anh",
   "start": 12.591,
   "end": 22.347
  },
  {
   "id": "c10",
   "card": "c10-torih2502",
   "kind": "read",
   "text": "Giây trước: tao sẽ không bao giờ yêu ai nữa! Giây sau: đăng bài tuyển người yêu.",
   "file": "release-21/voice/c10-da5336cb39a5-t1.1-L20.wav",
   "speaker": "torih2502",
   "voice": "Trúc Ly",
   "start": 22.627,
   "end": 25.979
  },
  {
   "id": "p2",
   "card": "post-loveli_zanory",
   "kind": "read",
   "text": "Cho tôi hỏi mấy người con gái, có thể cho tôi tham khảo vài cái sự thật vui về các bà được không?",
   "file": "release-21/voice/p2-eec87b40bf31-k1-t1.1-L20.wav",
   "speaker": "loveli_zanory",
   "voice": "Ngọc Linh",
   "start": 28.059,
   "end": 32.861
  },
  {
   "id": "c1",
   "card": "c1-cmtdaoeiiiiiii",
   "kind": "read",
   "text": "Tâm trạng thất thường của chúng tôi không phải do các anh đâu. Thi thoảng tự nhiên lăn ra ăn vạ, là do hoóc môn ấy. Nên các anh cứ dỗ đại đại đi, rồi chờ chúng tôi bình tĩnh lại, chúng tôi giải thích cho.",
   "file": "release-21/voice/c1-7a8cf54b0da9-k2-t1.1-L20.wav",
   "speaker": "cmtdaoeiiiiiii",
   "voice": "Mai Anh",
   "start": 33.141,
   "end": 43.917
  },
  {
   "id": "c2",
   "card": "c2-chocosweetwnrocinu",
   "kind": "read",
   "text": "Mỗi lần đến ngày, tao muốn chuyển giới. Qua đợt đó thì tao lại muốn làm con gái. Lặp lại như vậy mỗi tháng.",
   "file": "release-21/voice/c2-0fb562640cce-t1.1-L20.wav",
   "speaker": "chocosweetwnrocinu",
   "voice": "Trúc Ly",
   "start": 44.197,
   "end": 49.082
  },
  {
   "id": "c2a",
   "card": "c2a-loveli_zanory",
   "kind": "read",
   "text": "Chịu òi.",
   "file": "release-21/voice/c2a-15cf2a858035-k1-t1.1-L20.wav",
   "speaker": "loveli_zanory",
   "voice": "Ngọc Linh",
   "start": 49.362,
   "end": 50.093
  },
  {
   "id": "c5",
   "card": "c5-cheeseakameohoang",
   "kind": "read",
   "text": "Việc bạn gái các ông gọi cốt của nó bằng vợ, chồng, không nói lên việc bọn tôi lét đâu. Vì khả năng trước khi yêu các ông, thì cốt đã bị ôm hôn chán chê, vẫn còn thẳng.",
   "file": "release-21/voice/c5-9b413c42849b-t1.1-L20.wav",
   "speaker": "cheeseakameohoang",
   "voice": "Mai Anh",
   "start": 50.373,
   "end": 59.468
  },
  {
   "id": "c5a",
   "card": "c5a-loveli_zanory",
   "kind": "read",
   "text": "Sao vẫn thẳng được, mấy hay đó bạn.",
   "file": "release-21/voice/c5a-c8415418c285-t1.1-L20.wav",
   "speaker": "loveli_zanory",
   "voice": "Ngọc Linh",
   "start": 59.748,
   "end": 61.65
  },
  {
   "id": "c5b",
   "card": "c5b-cheeseakameohoang",
   "kind": "read",
   "text": "Cốt tôi vẫn thẳng, dù tôi sờ đủ chỗ trên người nó. Ô kê, vì nó không khó chịu.",
   "file": "release-21/voice/c5b-ac3c90b2e57a-k2-t1.1-L20.wav",
   "speaker": "cheeseakameohoang",
   "voice": "Mai Anh",
   "start": 61.93,
   "end": 66.671
  },
  {
   "id": "c5c",
   "card": "c5c-loveli_zanory",
   "kind": "read",
   "text": "Hừm, nghi vấn.",
   "file": "release-21/voice/c5c-bfa84db41573-t1.1-L20.wav",
   "speaker": "loveli_zanory",
   "voice": "Ngọc Linh",
   "start": 66.951,
   "end": 67.914
  },
  {
   "id": "z1",
   "card": "c5c-loveli_zanory",
   "kind": "bridge",
   "text": "Muốn nghe phần bốn thì bình luận nha!",
   "file": "release-21/voice/z1-00d74c5bc080-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 70.194,
   "end": 72.099
  }
 ],
