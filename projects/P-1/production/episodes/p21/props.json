 "lines": [
  {
   "id": "a0",
   "card": "post-zannee_luvu",
   "kind": "bridge",
   "text": "Một bạn đi khám vì sốt, gặp ngay anh bác sĩ trẻ, lại còn đẹp trai.",
   "file": "release-12/voice/a0-912ee102b191-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 0.1,
   "end": 3.817
  },
  {
   "id": "p2",
   "card": "post-zannee_luvu",
   "kind": "read",
   "text": "Em bị sốt bao lâu rồi?",
   "file": "release-12/voice/p2-f384943423d7-t1.1-L20.wav",
   "speaker": "bacsi",
   "voice": "Thiện Minh",
   "start": 4.097,
   "end": 5.491
  },
  {
   "id": "p3",
   "card": "post-zannee_luvu",
   "kind": "read",
   "text": "Dạ, em bị từ hồi chiều hôm qua.",
   "file": "release-12/voice/p3-7a452bfcfd40-t1.1-L20.wav",
   "speaker": "zannee_luvu",
   "voice": "Trúc Ly",
   "start": 5.771,
   "end": 7.301
  },
  {
   "id": "p4",
   "card": "post-zannee_luvu",
   "kind": "read",
   "text": "Hồi chiều... hả?",
   "file": "release-12/voice/p4-5604a3caac36-t1.1-L20.wav",
   "speaker": "bacsi",
   "voice": "Thiện Minh",
   "start": 7.581,
   "end": 8.384
  },
  {
   "id": "a1",
   "card": "post-zannee_luvu",
   "kind": "bridge",
   "text": "Bác sĩ trầm ngâm hồi lâu. Bệnh nhân bắt đầu run.",
   "file": "release-12/voice/a1-b8bd268664cb-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 8.664,
   "end": 11.286
  },
  {
   "id": "p6",
   "card": "post-zannee_luvu",
   "kind": "read",
   "text": "Hồi chiều... hồi chiều trời mưa.",
   "file": "release-12/voice/p6-9d71a67d68fc-t1.1-L20.wav",
   "speaker": "bacsi",
   "voice": "Thiện Minh",
   "start": 11.566,
   "end": 12.945
  },
  {
   "id": "p7",
   "card": "post-zannee_luvu",
   "kind": "read",
   "text": "Sau khi thấy tui đơ mặt ra, ổng cười hihi, xong kêu: khám xong rồi, ra lấy thuốc đi em.",
   "file": "release-12/voice/p7-b2420f214628-k1-t1.1-L20.wav",
   "speaker": "zannee_luvu",
   "voice": "Trúc Ly",
   "start": 15.125,
   "end": 19.065
  },
  {
   "id": "a2",
   "card": "c1-anla_1012",
   "kind": "bridge",
   "text": "Dân mạng cười muốn xỉu:",
   "file": "release-12/voice/a2-31d5541241fc-k1-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 19.345,
   "end": 20.593
  },
  {
   "id": "c1",
   "card": "c1-anla_1012",
   "kind": "read",
   "text": "Tao mà là bà, chắc tao cười banh phòng khám. Bác sĩ cũng tranh thủ bắt tren tí.",
   "file": "release-12/voice/c1-d9a74426276d-k2-t1.1-L20.wav",
   "speaker": "anla_1012",
   "voice": "Ngọc Huyền",
   "start": 20.873,
   "end": 24.951
  },
  {
   "id": "a3",
   "card": "c1a-zannee_luvu",
   "kind": "bridge",
   "text": "Và chủ bài kể thêm một chi tiết:",
   "file": "release-12/voice/a3-09c6eb28d310-t1.1-L20.wav",
   "speaker": "narrator",
   "voice": "Adam bựa",
   "start": 25.231,
   "end": 26.982
  },
  {
   "id": "c1a",
   "card": "c1a-zannee_luvu",
   "kind": "read",
   "text": "Đang bệnh, cái đầu lâng lâng nên hơi đơ. Ổng còn ráng nhìn tui ba giây, kiểu: anh đợi em cười đó.",
   "file": "release-12/voice/c1a-abb5ecfe5f14-t1.1-L20.wav",
   "speaker": "zannee_luvu",
   "voice": "Trúc Ly",
   "start": 27.262,
   "end": 31.565
  }
 ],
