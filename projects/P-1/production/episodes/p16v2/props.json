 "lines": [
  {
   "id": "p1",
   "card": "post-m0ichanchan",
   "kind": "read",
   "text": "Lấy nhau mười chín năm, và bố tao nhắn cho mẹ tao kiểu:",
   "file": "release-07/voice/p1-97910b37c925-t1.1.wav",
   "start": 0.1,
   "end": 3.021
  },
  {
   "id": "p2",
   "card": "post-m0ichanchan",
   "kind": "read",
   "text": "Em ăn cơm chưa.",
   "file": "release-07/voice/p2-f15fabe36d48-t1.1.wav",
   "start": 3.301,
   "end": 4.55
  },
  {
   "id": "a1",
   "card": "post-m0ichanchan",
   "kind": "bridge",
   "text": "Nhưng nhìn kỹ: mẹ tắt thông báo của bố luôn rồi.",
   "file": "release-07/voice/a1-bc27e6c94ee2-t1.1.wav",
   "start": 4.83,
   "end": 7.821
  },
  {
   "id": "c1",
   "card": "c1-dv.hqang_",
   "kind": "read",
   "text": "Sao mẹ bạn lại tắt thông báo tin nhắn của bố thế?",
   "file": "release-07/voice/c1-9fd45ebbfaa5-t1.1.wav",
   "start": 8.101,
   "end": 10.805
  },
  {
   "id": "c1a",
   "card": "c1a-user171107374920",
   "kind": "read",
   "text": "Chắc năm phút hỏi em ăn cơm chưa một lần.",
   "file": "release-07/voice/c1a-57c513e74e24-t1.1.wav",
   "start": 11.085,
   "end": 13.493
  },
  {
   "id": "c1b",
   "card": "c1b-m0ichanchan",
   "kind": "read",
   "text": "Ê, tắt của tao nữa. Mà không hiểu sao, nhắn cái là mẹ vẫn biết mà rep luôn.",
   "file": "release-07/voice/c1b-d5ec55dea16c-t1.1.wav",
   "start": 15.573,
   "end": 20.08
  },
  {
   "id": "a2",
   "card": "c1b-m0ichanchan",
   "kind": "bridge",
   "text": "Mười chín năm, vẫn rep trong một nốt nhạc.",
   "file": "release-07/voice/a2-a7691fedd94c-k1-t1.1.wav",
   "start": 20.36,
   "end": 22.769
  },
  {
   "id": "c2",
   "card": "c2-m0ichanchan",
   "kind": "read",
   "text": "Lúc sau mẹ tao rep: em ăn rồi.",
   "file": "release-07/voice/c2-3ee1efa8c9df-t1.1.wav",
   "start": 23.049,
   "end": 25.17
  }
 ],
