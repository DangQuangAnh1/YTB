{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Queue renderer script",
  "type": "object",
  "required": [
    "title",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "caption",
          "seconds"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "queue"
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "seconds": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          }
        }
      }
    }
  },
  "$comment": "Runtime additionally limits aggregate duration to 120 seconds."
}
