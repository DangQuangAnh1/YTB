{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator Agency state v1",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "goal",
    "constraints",
    "stage",
    "current_task",
    "plan",
    "approval",
    "decision_records",
    "artifacts",
    "reviews",
    "acceptance",
    "release",
    "next_action",
    "unresolved",
    "usage",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^P-[1-9][0-9]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "enum": [
        "intake",
        "scouting",
        "planning",
        "content",
        "production",
        "review"
      ]
    },
    "current_task": {
      "type": "object",
      "required": [
        "id",
        "owner_role",
        "execution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T-[0-9]{3,}$"
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "execution": {
          "enum": [
            "not_started",
            "running",
            "waiting_user",
            "blocked",
            "failed",
            "complete"
          ]
        }
      }
    },
    "plan": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "required": [
        "status",
        "record"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "revise",
            "rejected"
          ]
        },
        "record": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          ]
        }
      }
    },
    "decision_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "acceptance": {
      "enum": [
        "not_reviewed",
        "passed",
        "needs_revision",
        "unverified"
      ]
    },
    "release": {
      "const": "not_requested"
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "type": "object"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "$comment": "agency.py enforces filesystem scope, content hashes, decisions, lineage and review evidence in addition to this document shape. Schema validation alone does not authorize work."
}
